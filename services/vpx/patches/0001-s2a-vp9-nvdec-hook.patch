new file mode 100644
index 0000000..5634764
--- /dev/null
+++ b/vpx/s2a_vp9_nvdec.h
@@ -0,0 +1,61 @@
+/*
+ * S2Arm: decode one Switch NVDEC VP9 job with libvpx.
+ *
+ * NVDEC hands the decoder only the tile data plus the parsed frame state: the probability tables the frame uses
+ * (already including its forward updates), the previous frame's motion vectors, and buffers for this frame's motion
+ * vectors and symbol counts. The caller writes an uncompressed VP9 header (refresh_frame_context 0,
+ * frame_parallel_decoding_mode 0, error_resilient_mode 0, header_size_in_bytes 1), one stand-in byte for the
+ * compressed header, then the tile data. This entry point decodes that frame with the caller's tables instead of
+ * parsing a compressed header, takes the previous frame's MVs from the caller, skips backward adaptation, and writes
+ * MVs and counts in Ryujinx's layouts. With no call to this function libvpx behaves exactly as without the patch.
+ * Design: docs/设计_原生VP9/design_phase2_B.md (S2Arm repository).
+ */
+#ifndef VPX_VPX_S2A_VP9_NVDEC_H_
+#define VPX_VPX_S2A_VP9_NVDEC_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "./vpx_decoder.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define S2A_VP9_PROBS_SIZE 3087  /* Ryujinx.Graphics.Video.Vp9EntropyProbs */
+#define S2A_VP9_COUNTS_SIZE 13208 /* Ryujinx.Graphics.Video.Vp9BackwardUpdates */
+#define S2A_VP9_MVREF_SIZE 16    /* Ryujinx.Graphics.Video.Vp9MvRef: int16 row,col x2, int32 ref x2 */
+
+#define S2A_VP9_OK 0
+#define S2A_VP9_UNREPR 1   /* not representable; libvpx state untouched; decode this job elsewhere */
+#define S2A_VP9_NEED_KEY 2 /* not representable after the header was read; libvpx now needs a key frame */
+#define S2A_VP9_ERROR (-1) /* decode error; libvpx now needs a key frame */
+
+typedef struct {
+  const uint8_t *probs;        /* S2A_VP9_PROBS_SIZE bytes */
+  int32_t intra_frame;         /* 1 for a key or intra-only frame, else 0 */
+  int32_t tx_mode;             /* 0..4 */
+  int32_t reference_mode;      /* 0..2; ignored on intra frames */
+  int32_t comp_fixed_ref;      /* checked against libvpx's derivation when reference_mode != 0 */
+  int32_t comp_var_ref0, comp_var_ref1;
+  int32_t use_prev_frame_mvs;
+  int32_t mi_count;            /* entries in prev_mvs and mvs: mi_rows * mi_cols of this frame */
+  const uint8_t *prev_mvs;     /* mi_count Vp9MvRef entries; NULL when use_prev_frame_mvs is 0 */
+  uint8_t *mvs;                /* mi_count Vp9MvRef entries, written on S2A_VP9_OK */
+  uint8_t *counts;             /* S2A_VP9_COUNTS_SIZE bytes, written on S2A_VP9_OK */
+} s2a_vp9_nvdec_io;
+
+typedef struct {
+  const uint8_t *planes[3];
+  int32_t strides[3];
+  int32_t width, height;       /* visible size; valid until the next decode call */
+} s2a_vp9_nvdec_picture;
+
+int s2a_vp9_nvdec_decode(vpx_codec_ctx_t *ctx, const uint8_t *frame, size_t size, const s2a_vp9_nvdec_io *io,
+                         s2a_vp9_nvdec_picture *pic);
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#endif  // VPX_VPX_S2A_VP9_NVDEC_H_
