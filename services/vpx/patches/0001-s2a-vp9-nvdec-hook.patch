 }
 
+// S2Arm NVDEC hook: decode exactly one frame (no superframe index, no trailing
+// frames) with the caller's tables and MVs. See vpx/s2a_vp9_nvdec.h.
+int s2a_vp9_nvdec_decode(vpx_codec_ctx_t *ctx, const uint8_t *frame,
+                         size_t size, const s2a_vp9_nvdec_io *io,
+                         s2a_vp9_nvdec_picture *pic) {
+  vpx_codec_alg_priv_t *priv;
+  VP9Decoder *pbi;
+  const s2a_vp9_probs_layout *probs;
+  const uint8_t *data = frame;
+  const YV12_BUFFER_CONFIG *shown;
+
+  if (ctx == NULL || ctx->priv == NULL || ctx->iface != vpx_codec_vp9_dx() ||
+      frame == NULL || size < 3 || io == NULL || io->probs == NULL ||
+      io->mvs == NULL || io->counts == NULL || pic == NULL ||
+      io->mi_count <= 0 || (io->use_prev_frame_mvs && io->prev_mvs == NULL))
+    return S2A_VP9_UNREPR;
+  priv = (vpx_codec_alg_priv_t *)ctx->priv;
+  probs = (const s2a_vp9_probs_layout *)io->probs;
+  if (!s2a_vp9_pivot_probs_nonzero(probs)) return S2A_VP9_UNREPR;
+  if (io->intra_frame && !s2a_vp9_kf_tables_match(probs))
+    return S2A_VP9_UNREPR;
+
+  if (priv->pbi == NULL) {
+    const vpx_codec_err_t res = init_decoder(priv);
+    if (res != VPX_CODEC_OK) {
+      ctx->err = res;
+      return S2A_VP9_ERROR;
+    }
+  }
+  pbi = priv->pbi;
+
+  if (io->use_prev_frame_mvs) {
+    if (pbi->s2a_mvs_size < io->mi_count) {
+      vpx_free(pbi->s2a_mvs);
+      pbi->s2a_mvs = (MV_REF *)vpx_malloc(sizeof(*pbi->s2a_mvs) * io->mi_count);
+      pbi->s2a_mvs_size = pbi->s2a_mvs ? io->mi_count : 0;
+      if (pbi->s2a_mvs == NULL) {
+        ctx->err = VPX_CODEC_MEM_ERROR;
+        return S2A_VP9_ERROR;
+      }
+    }
+    if (!s2a_vp9_import_mvs(io->prev_mvs, pbi->s2a_mvs, io->mi_count))
+      return S2A_VP9_UNREPR;
+  }
+
+  pbi->decrypt_cb = priv->decrypt_cb;
+  pbi->decrypt_state = priv->decrypt_state;
+  pbi->s2a_unrepr = 0;
+  pbi->common.s2a_prev_mvs = NULL;
+  pbi->s2a_io = io;
+  if (vp9_receive_compressed_data(pbi, size, &data)) {
+    const int unrepr = pbi->s2a_unrepr;
+    pbi->s2a_io = NULL;
+    pbi->common.s2a_prev_mvs = NULL;
+    pbi->cur_buf->buf.corrupted = 1;
+    pbi->need_resync = 1;
+    priv->need_resync = 1;
+    ctx->err = update_error_state(priv, &pbi->common.error);
+    return unrepr ? S2A_VP9_NEED_KEY : S2A_VP9_ERROR;
+  }
+  pbi->s2a_io = NULL;
+  pbi->common.s2a_prev_mvs = NULL;
+  ctx->err = VPX_CODEC_OK;
+
+  shown = pbi->common.frame_to_show;
+  pic->planes[0] = shown->y_buffer;
+  pic->planes[1] = shown->u_buffer;
+  pic->planes[2] = shown->v_buffer;
+  pic->strides[0] = shown->y_stride;
+  pic->strides[1] = shown->uv_stride;
+  pic->strides[2] = shown->uv_stride;
+  pic->width = shown->y_crop_width;
+  pic->height = shown->y_crop_height;
+  return S2A_VP9_OK;
+}
