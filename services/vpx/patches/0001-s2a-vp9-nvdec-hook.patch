diff --git a/vp9/decoder/vp9_s2a_nvdec.c b/vp9/decoder/vp9_s2a_nvdec.c
new file mode 100644
index 0000000..875389a
--- /dev/null
+++ b/vp9/decoder/vp9_s2a_nvdec.c
@@ -0,0 +1,124 @@
+/*
+ * S2Arm: Ryujinx layout conversions for the NVDEC hook (see vp9_s2a_nvdec.h and vpx/s2a_vp9_nvdec.h).
+ */
+#include <assert.h>
+#include <string.h>
+
+#include "vp9/decoder/vp9_s2a_nvdec.h"
+
+static_assert(sizeof(s2a_vp9_probs_layout) == S2A_VP9_PROBS_SIZE, "Vp9EntropyProbs size");
+static_assert(sizeof(s2a_vp9_counts_layout) == S2A_VP9_COUNTS_SIZE, "Vp9BackwardUpdates size");
+static_assert(sizeof(((FRAME_COUNTS *)0)->coef) == sizeof(((s2a_vp9_counts_layout *)0)->coef), "coef counts");
+static_assert(sizeof(((FRAME_COUNTS *)0)->eob_branch) == sizeof(((s2a_vp9_counts_layout *)0)->eob_branch),
+              "eob counts");
+static_assert(sizeof(((FRAME_CONTEXT *)0)->coef_probs) == sizeof(((s2a_vp9_probs_layout *)0)->coef), "coef probs");
+
+int s2a_vp9_kf_tables_match(const s2a_vp9_probs_layout *p) {
+  return memcmp(p->kf_y_mode, vp9_kf_y_mode_prob, sizeof(p->kf_y_mode)) == 0 &&
+         memcmp(p->kf_uv_mode, vp9_kf_uv_mode_prob, sizeof(p->kf_uv_mode)) == 0 &&
+         memcmp(p->kf_partition, vp9_kf_partition_probs, sizeof(p->kf_partition)) == 0;
+}
+
+int s2a_vp9_pivot_probs_nonzero(const s2a_vp9_probs_layout *p) {
+  int t, pl, r, b, c;
+  for (t = 0; t < 4; ++t)
+    for (pl = 0; pl < 2; ++pl)
+      for (r = 0; r < 2; ++r)
+        for (b = 0; b < 6; ++b)
+          for (c = 0; c < BAND_COEFF_CONTEXTS(b); ++c)
+            if (p->coef[t][pl][r][b][c][PIVOT_NODE] == 0) return 0;
+  return 1;
+}
+
+void s2a_vp9_probs_to_fc(const s2a_vp9_probs_layout *p, FRAME_CONTEXT *fc) {
+  int i;
+  memcpy(fc->y_mode_prob, p->y_mode, sizeof(fc->y_mode_prob));
+  memcpy(fc->uv_mode_prob, p->uv_mode, sizeof(fc->uv_mode_prob));
+  memcpy(fc->partition_prob, p->partition, sizeof(fc->partition_prob));
+  memcpy(fc->coef_probs, p->coef, sizeof(fc->coef_probs));
+  memcpy(fc->switchable_interp_prob, p->switchable_interp, sizeof(fc->switchable_interp_prob));
+  memcpy(fc->inter_mode_probs, p->inter_mode, sizeof(fc->inter_mode_probs));
+  memcpy(fc->intra_inter_prob, p->intra_inter, sizeof(fc->intra_inter_prob));
+  memcpy(fc->comp_inter_prob, p->comp_inter, sizeof(fc->comp_inter_prob));
+  memcpy(fc->single_ref_prob, p->single_ref, sizeof(fc->single_ref_prob));
+  memcpy(fc->comp_ref_prob, p->comp_ref, sizeof(fc->comp_ref_prob));
+  memcpy(fc->tx_probs.p32x32, p->tx32x32, sizeof(fc->tx_probs.p32x32));
+  memcpy(fc->tx_probs.p16x16, p->tx16x16, sizeof(fc->tx_probs.p16x16));
+  memcpy(fc->tx_probs.p8x8, p->tx8x8, sizeof(fc->tx_probs.p8x8));
+  memcpy(fc->skip_probs, p->skip, sizeof(fc->skip_probs));
+  memcpy(fc->nmvc.joints, p->joints, sizeof(fc->nmvc.joints));
+  for (i = 0; i < 2; ++i) {
+    nmv_component *const comp = &fc->nmvc.comps[i];
+    comp->sign = p->sign[i];
+    memcpy(comp->classes, p->classes[i], sizeof(comp->classes));
+    memcpy(comp->class0, p->class0[i], sizeof(comp->class0));
+    memcpy(comp->bits, p->bits[i], sizeof(comp->bits));
+    memcpy(comp->class0_fp, p->class0_fp[i], sizeof(comp->class0_fp));
+    memcpy(comp->fp, p->fp[i], sizeof(comp->fp));
+    comp->class0_hp = p->class0_hp[i];
+    comp->hp = p->hp[i];
+  }
+}
+
+void s2a_vp9_counts_from(const FRAME_COUNTS *c, s2a_vp9_counts_layout *o) {
+  int i;
+  memcpy(o->y_mode, c->y_mode, sizeof(o->y_mode));
+  memcpy(o->uv_mode, c->uv_mode, sizeof(o->uv_mode));
+  memcpy(o->partition, c->partition, sizeof(o->partition));
+  memcpy(o->coef, c->coef, sizeof(o->coef));
+  memcpy(o->eob_branch, c->eob_branch, sizeof(o->eob_branch));
+  memcpy(o->switchable_interp, c->switchable_interp, sizeof(o->switchable_interp));
+  memcpy(o->inter_mode, c->inter_mode, sizeof(o->inter_mode));
+  memcpy(o->intra_inter, c->intra_inter, sizeof(o->intra_inter));
+  memcpy(o->comp_inter, c->comp_inter, sizeof(o->comp_inter));
+  memcpy(o->single_ref, c->single_ref, sizeof(o->single_ref));
+  memcpy(o->comp_ref, c->comp_ref, sizeof(o->comp_ref));
+  memcpy(o->tx32x32, c->tx.p32x32, sizeof(o->tx32x32));
+  memcpy(o->tx16x16, c->tx.p16x16, sizeof(o->tx16x16));
+  memcpy(o->tx8x8, c->tx.p8x8, sizeof(o->tx8x8));
+  memcpy(o->skip, c->skip, sizeof(o->skip));
+  memcpy(o->joints, c->mv.joints, sizeof(o->joints));
+  for (i = 0; i < 2; ++i) {
+    const nmv_component_counts *const comp = &c->mv.comps[i];
+    memcpy(o->sign[i], comp->sign, sizeof(o->sign[i]));
+    memcpy(o->classes[i], comp->classes, sizeof(o->classes[i]));
+    memcpy(o->class0[i], comp->class0, sizeof(o->class0[i]));
+    memcpy(o->bits[i], comp->bits, sizeof(o->bits[i]));
+    memcpy(o->class0_fp[i], comp->class0_fp, sizeof(o->class0_fp[i]));
+    memcpy(o->fp[i], comp->fp, sizeof(o->fp[i]));
+    memcpy(o->class0_hp[i], comp->class0_hp, sizeof(o->class0_hp[i]));
+    memcpy(o->hp[i], comp->hp, sizeof(o->hp[i]));
+  }
+}
+
+int s2a_vp9_import_mvs(const uint8_t *src, MV_REF *dst, int n) {
+  int i, j;
+  for (i = 0; i < n; ++i, src += S2A_VP9_MVREF_SIZE) {
+    int16_t mv[4];
+    int32_t ref[2];
+    memcpy(mv, src, sizeof(mv));
+    memcpy(ref, src + 8, sizeof(ref));
+    for (j = 0; j < 2; ++j) {
+      if (ref[j] < -1 || ref[j] > 3) return 0;
+      dst[i].mv[j].as_mv.row = mv[2 * j];
+      dst[i].mv[j].as_mv.col = mv[2 * j + 1];
+      dst[i].ref_frame[j] = (MV_REFERENCE_FRAME)ref[j];
+    }
+  }
+  return 1;
+}
+
+void s2a_vp9_export_mvs(const MV_REF *src, uint8_t *dst, int n) {
+  int i, j;
+  for (i = 0; i < n; ++i, dst += S2A_VP9_MVREF_SIZE) {
+    int16_t mv[4];
+    int32_t ref[2];
+    for (j = 0; j < 2; ++j) {
+      mv[2 * j] = src[i].mv[j].as_mv.row;
+      mv[2 * j + 1] = src[i].mv[j].as_mv.col;
+      ref[j] = src[i].ref_frame[j];
+    }
+    memcpy(dst, mv, sizeof(mv));
+    memcpy(dst + 8, ref, sizeof(ref));
+  }
+}
