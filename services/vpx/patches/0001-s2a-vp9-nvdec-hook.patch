+/*
+ * S2Arm: Ryujinx data layouts and conversions for vpx/s2a_vp9_nvdec.h.
+ * The structs mirror Ryujinx.Graphics.Video.Vp9EntropyProbs / Vp9BackwardUpdates field for field (C# sequential
+ * layout, no padding); the sizes are asserted in vp9_s2a_nvdec.c and in the S2Arm tests.
+ */
+#ifndef VPX_VP9_DECODER_VP9_S2A_NVDEC_H_
+#define VPX_VP9_DECODER_VP9_S2A_NVDEC_H_
+
+#include "vpx/s2a_vp9_nvdec.h"
+#include "vp9/common/vp9_entropymode.h"
+#include "vp9/common/vp9_onyxc_int.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct {
+  uint8_t kf_y_mode[10][10][9];
+  uint8_t seg_tree[7];
+  uint8_t seg_pred[3];
+  uint8_t kf_uv_mode[10][9];
+  uint8_t y_mode[4][9];
+  uint8_t uv_mode[10][9];
+  uint8_t kf_partition[16][3];
+  uint8_t partition[16][3];
+  uint8_t coef[4][2][2][6][6][3];
+  uint8_t switchable_interp[4][2];
+  uint8_t inter_mode[7][3];
+  uint8_t intra_inter[4];
+  uint8_t comp_inter[5];
+  uint8_t single_ref[5][2];
+  uint8_t comp_ref[5];
+  uint8_t tx32x32[2][3];
+  uint8_t tx16x16[2][2];
+  uint8_t tx8x8[2][1];
+  uint8_t skip[3];
+  uint8_t joints[3];
+  uint8_t sign[2];
+  uint8_t classes[2][10];
+  uint8_t class0[2][1];
+  uint8_t bits[2][10];
+  uint8_t class0_fp[2][2][3];
+  uint8_t fp[2][3];
+  uint8_t class0_hp[2];
+  uint8_t hp[2];
+} s2a_vp9_probs_layout;
+
+typedef struct {
+  uint32_t y_mode[4][10];
+  uint32_t uv_mode[10][10];
+  uint32_t partition[16][4];
+  uint32_t coef[4][2][2][6][6][4];
+  uint32_t eob_branch[4][2][2][6][6];
+  uint32_t switchable_interp[4][3];
+  uint32_t inter_mode[7][4];
+  uint32_t intra_inter[4][2];
+  uint32_t comp_inter[5][2];
+  uint32_t single_ref[5][2][2];
+  uint32_t comp_ref[5][2];
+  uint32_t tx32x32[2][4];
+  uint32_t tx16x16[2][3];
+  uint32_t tx8x8[2][2];
+  uint32_t skip[3][2];
+  uint32_t joints[4];
+  uint32_t sign[2][2];
+  uint32_t classes[2][11];
+  uint32_t class0[2][2];
+  uint32_t bits[2][10][2];
+  uint32_t class0_fp[2][2][4];
+  uint32_t fp[2][4];
+  uint32_t class0_hp[2][2];
+  uint32_t hp[2][2];
+} s2a_vp9_counts_layout;
+
+/* 1 when the guest's key-frame tables equal libvpx's constants (libvpx cannot use other tables). */
+int s2a_vp9_kf_tables_match(const s2a_vp9_probs_layout *p);
+/* 1 when every reachable coefficient context has a non-zero pivot-node probability (0 would index
+ * vp9_pareto8_full[-1]). Band 0 contexts 3..5 are unreachable and stay 0 in libvpx's own tables. */
+int s2a_vp9_pivot_probs_nonzero(const s2a_vp9_probs_layout *p);
+void s2a_vp9_probs_to_fc(const s2a_vp9_probs_layout *p, FRAME_CONTEXT *fc);
+void s2a_vp9_counts_from(const FRAME_COUNTS *c, s2a_vp9_counts_layout *out);
+/* Guest Vp9MvRef entries -> MV_REF. Returns 0 if any reference index is outside -1..3. */
+int s2a_vp9_import_mvs(const uint8_t *src, MV_REF *dst, int n);
+void s2a_vp9_export_mvs(const MV_REF *src, uint8_t *dst, int n);
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#endif  // VPX_VP9_DECODER_VP9_S2A_NVDEC_H_
