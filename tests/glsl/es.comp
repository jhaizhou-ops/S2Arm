#version 310 es
precision highp float;
precision highp int;
precision highp sampler2D;
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(std140, binding = 0) uniform Params { vec4 addend; } params;
layout(std430, binding = 0) buffer Data { vec4 values[]; } data;
layout(binding = 0) uniform sampler2D source;
uniform float scale;
void main() { data.values[0] = textureLod(source, vec2(0.5), 0.0) * scale + params.addend; }
