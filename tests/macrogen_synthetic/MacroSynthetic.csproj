    <Compile Include="../../compat/tree/src/Ryujinx.Graphics.Gpu/Engine/MME/MacroInterpreter.cs" />
    <Compile Include="../../compat/tree/src/Ryujinx.Graphics.Gpu/Engine/MME/MacroJitContext.cs" />
    <Compile Include="../../compat/tree/src/Ryujinx.Graphics.Gpu/Engine/MME/IMacroEE.cs" />
    <Compile Include="../../compat/tree/src/Ryujinx.Graphics.Gpu/Engine/MME/AluOperation.cs" />
    <Compile Include="../../compat/tree/src/Ryujinx.Graphics.Gpu/Engine/MME/AluRegOperation.cs" />
    <Compile Include="../../compat/tree/src/Ryujinx.Graphics.Gpu/Engine/MME/AssignmentOperation.cs" />
    <Compile Include="../../compat/tree/src/Ryujinx.Graphics.Device/IDeviceState.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="$(SyntheticTable)" Condition="'$(SyntheticTable)' != ''" />
  </ItemGroup>
</Project>
