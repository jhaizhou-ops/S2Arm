<Project Sdk="Microsoft.NET.Sdk">
  <!-- 宽屏包装层 CPU 回放基准（不起局、不用 GPU）：整份 WidenRenderer 套在空渲染器上回放录像。构建请带 artifacts 目录，免得往 compat/tree 里写 obj。
       同一份源码可对旧代码编：没有 graphics/widen/CbufShadow.cs（读到才扫之前）就不定义 WIDEN_LAZY，影子对照不编。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <DefineConstants Condition="Exists('../../../graphics/widen/CbufShadow.cs')">$(DefineConstants);WIDEN_LAZY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../graphics/widen/gal/S2Arm.Gfx.Widen.Gal.csproj" />
    <ProjectReference Include="../galrec/S2Arm.GalRec.csproj" />
  </ItemGroup>
</Project>
