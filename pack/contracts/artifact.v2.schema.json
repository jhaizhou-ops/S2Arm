{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:s2a:contracts:artifact:v2",
  "title": "ArtifactManifest v2",
  "type": "object",
  "properties": {
    "schema": {
      "const": "s2a.artifact.v2"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[^\\x00]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "additionalProperties": true
      }
    },
    "details": {
      "type": "object"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "fingerprint": {
      "$ref": "#/$defs/fingerprint"
    }
  },
  "required": [
    "schema",
    "target",
    "files",
    "details"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "target": {
            "const": "ios"
          }
        },
        "required": [
          "target"
        ]
      },
      "then": {
        "properties": {
          "details": {
            "type": "object",
            "properties": {
              "schema": {
                "const": "s2a.artifact.ios.v1"
              },
              "ipa": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[^\\x00]+$"
              },
              "resourcePack": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[^\\x00]+$"
              },
              "buildId": {
                "type": "string"
              },
              "device": {
                "type": "object",
                "properties": {
                  "gpuArch": {
                    "type": "string",
                    "minLength": 1
                  },
                  "os": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "gpuArch",
                  "os"
                ],
                "additionalProperties": true
              }
            },
            "required": [
              "schema",
              "ipa",
              "resourcePack",
              "buildId",
              "device"
            ],
            "additionalProperties": true
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "archive": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[^\\x00]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "stageKeys": {
          "type": "object",
          "properties": {
            ".stage_rewrite": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            ".stage_caps": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            ".stage_sysdata": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            ".stage_uilayout": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            ".stage_aoc": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            ".stage_romfsidx": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            ".stage_shaders": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            ".stage_direct": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          },
          "required": [
            ".stage_rewrite",
            ".stage_sysdata",
            ".stage_uilayout",
            ".stage_aoc",
            ".stage_romfsidx",
            ".stage_shaders",
            ".stage_direct"
          ],
          "additionalProperties": false
        },
        "dual": {
          "type": "boolean"
        },
        "directChain": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^b-[0-9a-f]+$"
        }
      },
      "required": [
        "stageKeys",
        "dual",
        "directChain"
      ],
      "additionalProperties": false
    },
    "fingerprint": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "s2a.content-fingerprint.v1"
        },
        "value": {
          "$ref": "#/$defs/sha256"
        },
        "components": {
          "type": "object",
          "properties": {
            "executableSha256": {
              "$ref": "#/$defs/sha256"
            },
            "resourceIndexSha256": {
              "$ref": "#/$defs/sha256"
            },
            "pipelineArchives": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/archive"
              }
            }
          },
          "required": [
            "executableSha256",
            "resourceIndexSha256",
            "pipelineArchives"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema",
        "value",
        "components"
      ],
      "additionalProperties": false
    }
  }
}
