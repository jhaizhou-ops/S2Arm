internal static class Vk {public const uint QueueFamilyIgnored=uint.MaxValue;}
internal unsafe struct SwapchainPresentFenceInfoEXT {public StructureType SType; public uint SwapchainCount; public Fence* PFences;}
internal struct FenceCreateInfo {public StructureType SType;}
internal unsafe struct PresentInfoKHR {public StructureType SType; public void* PNext; public uint WaitSemaphoreCount,SwapchainCount; public Semaphore* PWaitSemaphores; public SwapchainKHR* PSwapchains; public uint* PImageIndices; public Result* PResults;}
internal struct Extent2D {public uint Width,Height; public Extent2D(uint w,uint h){Width=w;Height=h;}}
internal enum SurfaceTransformFlagsKHR {IdentityBitKhr=1}
internal struct SurfaceCapabilitiesKHR {public Extent2D CurrentExtent,MinImageExtent,MaxImageExtent; public SurfaceTransformFlagsKHR CurrentTransform;}
internal sealed class FenceHolder {public int Gets,Puts; public void Get()=>Gets++; public void Put()=>Puts++; public Fence GetUnsafe()=>new(){Handle=1};}
internal sealed class CommandBufferScoped(FenceHolder f) {public CommandBuffer CommandBuffer; public FenceHolder GetFence()=>f;}
internal sealed class Pool {
 public readonly FenceHolder Fence=new(); public int Submits;public ulong Waited,Signalled; public bool FailSubmit;
 public CommandBufferScoped Rent()=>new(Fence);
 public void Return(CommandBufferScoped c,ReadOnlySpan<Semaphore> wait,ReadOnlySpan<PipelineStageFlags> stages,ReadOnlySpan<Semaphore> signal) {
  if(FailSubmit)throw new Exception("Injected actual QueueSubmit failure");
  AndroidWindow.Check(wait.Length==1 && stages.Length==1,"Drain did not wait one acquire");
  Waited=wait[0].Handle; Signalled=signal.Length==0?0:signal[0].Handle; Submits++;
 }
 public bool Completed=true; public bool CollectCompleted()=>Completed;
}
internal static class Trace { internal static readonly List<string> Events = new(); }
internal sealed unsafe class Api {
 public bool SubmitComplete,PresentComplete; public int DestroyedSemaphores,QueueWaitCalls; public Result WaitResult=Result.Success,DeviceWaitResult=Result.Success;
 public Result DeviceWaitIdle(int device) {Trace.Events.Add(DeviceWaitResult==Result.Success?"device-idle-success":"device-idle-failed");return DeviceWaitResult;}
 public Result QueueWaitIdle(int q) {QueueWaitCalls++; Trace.Events.Add("queue-idle"); return WaitResult;}
 public Result GetFenceStatus(int d,Fence f) {var ready=(f.Handle<100?SubmitComplete:PresentComplete); if(ready && f.Handle<100) Trace.Events.Add("submit-complete"); return ready?Result.Success:Result.NotReady;}
 public Result CreateFence(int d,in FenceCreateInfo i,void* a,out Fence f) {f=new(){Handle=100};return Result.Success;}
 public void DestroyFence(int d,Fence f,void* a) {}
 public void DestroySemaphore(int d,Semaphore s,void* a) {DestroyedSemaphores++;if(s.Handle>=11) Trace.Events.Add("destroy-finished");}
 public void CmdPipelineBarrier(CommandBuffer c,PipelineStageFlags s,PipelineStageFlags t,int dep,int n,void* p,int m,void* q,int k,in ImageMemoryBarrier b) {}
}
internal sealed unsafe class SwapchainApi {
 public Action AfterAcquire; public int Presents,Destroyed; public uint ImageIndex; public bool SawPresentFenceInfo;
 public Result AcquireResult=Result.Success,PresentResult=Result.Success,PresentImageResult=Result.Success;
 public Result AcquireNextImage(int d,SwapchainKHR s,ulong timeout,Semaphore semaphore,Fence f,ref uint image) {image=ImageIndex; AfterAcquire?.Invoke();return AcquireResult;}
 public Result QueuePresent(int q,in PresentInfoKHR i) {Presents++;SawPresentFenceInfo=i.PNext!=null;*i.PResults=PresentImageResult;return PresentResult;}
 public void DestroySwapchain(int d,SwapchainKHR s,void* a) {Destroyed++; Trace.Events.Add("destroy-chain");}
}
internal sealed class SurfaceApi {public ulong LostHandle; public Result GetPhysicalDeviceSurfaceCapabilities(int p,Fence s,out SurfaceCapabilitiesKHR c) {c=new(){CurrentExtent=new(){Width=1280,Height=720},MinImageExtent=new(1,1),MaxImageExtent=new(4096,4096)};return s.Handle==LostHandle ? Result.ErrorSurfaceLostKhr : Result.Success;}}
