internal struct Fence {public ulong Handle;}
internal struct SwapchainKHR {public ulong Handle;}
internal struct CommandBuffer {}
internal enum Result {Success,SuboptimalKhr,Timeout,NotReady,ErrorOutOfDateKhr,ErrorSurfaceLostKhr,ErrorDeviceLost,ErrorUnknown}
internal static class Results {public static void ThrowOnError(this Result r) {if(r!=Result.Success)throw new Exception("Driver "+r);}}
internal enum ImageLayout {Undefined,General,PresentSrcKhr}
internal enum AccessFlags {ColorAttachmentWriteBit=1}
internal enum PipelineStageFlags {AllCommandsBit,ColorAttachmentOutputBit}
