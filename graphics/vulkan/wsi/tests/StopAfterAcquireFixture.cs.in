 public readonly Api Api=new();public readonly Pool CommandBufferPool=new();public readonly SwapchainApi SwapchainApi=new();public readonly SurfaceApi SurfaceApi=new();
 public readonly Pipeline PipelineInternal=new();public readonly Helper HelperShader=new(); public readonly object QueueLock=new();public int Queue,Creates; public Action S2ADeviceCleanup;
 public readonly Features EnabledDeviceFeatures=new(); public void FlushAllCommands() {}
}
internal sealed class Host {public readonly NativeLease Lease=Producer.Create();public bool HasPresentFences;public long S2AStartedTick;public Func<long> Lifecycle=()=>0;public Fence Surface=new(){Handle=1};public int Destroyed;public void DestroySurface(){Destroyed++;Trace.Events.Add("destroy-surface");Surface=default;}public void CreateSurface(){Surface=new(){Handle=2};}}
internal static unsafe class Producer {
 internal static NativeLeaseState State;internal static int Acks;
 internal static void Reset() {State=new(){Session=1,Generation=1,Revision=1,Window=42,Width=1280,Height=720,Foreground=1,RefreshHz=60};Acks=0;}
 internal static NativeLease Create() {NativeLeaseApi api=new(){Size=(uint)sizeof(NativeLeaseApi),Version=1,Lease=1,Wait=&Wait,Take=&Take,ReleaseWindow=&Release,Released=&Ack,Wake=&Wake};return new NativeLease((nint)(&api),1,1);}
 [UnmanagedCallersOnly(CallConvs=new[]{typeof(CallConvCdecl)})]private static int Wait(nint l,NativeLeaseState* s,int ms)=>0;
 [UnmanagedCallersOnly(CallConvs=new[]{typeof(CallConvCdecl)})]private static int Take(nint l,NativeLeaseState* s){*s=State;return 0;}
 [UnmanagedCallersOnly(CallConvs=new[]{typeof(CallConvCdecl)})]private static void Release(nint l,nint w){}
 [UnmanagedCallersOnly(CallConvs=new[]{typeof(CallConvCdecl)})]private static void Ack(nint l,ulong g){Acks++;Trace.Events.Add("ack");}
 [UnmanagedCallersOnly(CallConvs=new[]{typeof(CallConvCdecl)})]private static void Wake(nint l){}
}
internal static class Program {static int Main(string[] args) {new AndroidWindow().Run(args[0]);Console.WriteLine($"PASS {AndroidWindow.Checks} checks; actual Present/Poll/NativeLease/Ledger; controlled driver only, no GPU/native memory.");return 0;}}

