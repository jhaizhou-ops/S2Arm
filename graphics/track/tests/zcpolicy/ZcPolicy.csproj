<!-- 零拷贝用法规则单测（帧率能耗线 10-23）：只给 GPU 输出缓冲开零拷贝、被模拟引擎写到即降级。用法见 Program.cs 头 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RyuTree Condition="'$(RyuTree)' == ''">$(MSBuildThisFileDirectory)../../../../compat/tree</RyuTree>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RyuTree)/src/Ryujinx.Memory/Ryujinx.Memory.csproj" />
    <ProjectReference Include="$(RyuTree)/src/Ryujinx.Cpu/Ryujinx.Cpu.csproj" />
    <ProjectReference Include="$(RyuTree)/src/Ryujinx.Graphics.Gpu/Ryujinx.Graphics.Gpu.csproj" />
    <!-- 产品的客体内存视图原样编进来（游戏地址 = 宿主地址；SignalMemoryTracking → MemoryTracking.VirtualMemoryEvent，WriteUntracked 直接写） -->
    <Compile Include="$(MSBuildThisFileDirectory)../../../../services/S2A.Services/GuestMemory.cs" Link="GuestMemory.cs" />
  </ItemGroup>
</Project>
