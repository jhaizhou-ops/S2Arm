<!-- 部分回写换算单测（帧率能耗线 10-23）：S2APartialLayout 逐子页写出的字节 = Ryujinx 原版 LayoutConverter 整张转换的同一段。用法见 Program.cs 头 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RyuTree Condition="'$(RyuTree)' == ''">$(MSBuildThisFileDirectory)../../../../compat/tree</RyuTree>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RyuTree)/src/Ryujinx.Graphics.Texture/Ryujinx.Graphics.Texture.csproj" />
  </ItemGroup>
</Project>
