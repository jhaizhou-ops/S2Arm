; t_fbr 第一次绘制的片元：附件 A（位置 0）= 像素中心渐变 (FragCoord.x/32, FragCoord.y/32, 0.5, 1)，B（位置 1）= 0
               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint Fragment %main "main" %fc %o0 %o1
               OpExecutionMode %main OriginUpperLeft
               OpDecorate %fc BuiltIn FragCoord
               OpDecorate %o0 Location 0
               OpDecorate %o1 Location 1
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
      %float = OpTypeFloat 32
        %v4f = OpTypeVector %float 4
     %ptrIv4 = OpTypePointer Input %v4f
         %fc = OpVariable %ptrIv4 Input
     %ptrOv4 = OpTypePointer Output %v4f
         %o0 = OpVariable %ptrOv4 Output
         %o1 = OpVariable %ptrOv4 Output
         %f0 = OpConstant %float 0
         %f1 = OpConstant %float 1
      %fhalf = OpConstant %float 0.5
        %c32 = OpConstant %float 0.03125
      %zero4 = OpConstantComposite %v4f %f0 %f0 %f0 %f0
       %main = OpFunction %void None %fn
      %entry = OpLabel
          %f = OpLoad %v4f %fc
         %fx = OpCompositeExtract %float %f 0
         %fy = OpCompositeExtract %float %f 1
          %r = OpFMul %float %fx %c32
          %g = OpFMul %float %fy %c32
          %v = OpCompositeConstruct %v4f %r %g %fhalf %f1
               OpStore %o0 %v
               OpStore %o1 %zero4
               OpReturn
               OpFunctionEnd
