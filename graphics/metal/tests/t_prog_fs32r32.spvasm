       %in28 = OpVariable %pin Input
       %in29 = OpVariable %pin Input
       %in30 = OpVariable %pin Input
       %in31 = OpVariable %pin Input
        %out = OpVariable %pout Output
       %main = OpFunction %void None %fn
      %entry = OpLabel
         %l0 = OpLoad %v4 %in0
         %l1 = OpLoad %v4 %in1
         %l2 = OpLoad %v4 %in2
         %l3 = OpLoad %v4 %in3
         %l4 = OpLoad %v4 %in4
         %l5 = OpLoad %v4 %in5
