               OpDecorate %in27 Location 27
               OpDecorate %in28 Location 28
               OpDecorate %in29 Location 29
               OpDecorate %in30 Location 30
               OpDecorate %in31 Location 31
               OpDecorate %out Location 0
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
      %float = OpTypeFloat 32
         %v4 = OpTypeVector %float 4
       %pin = OpTypePointer Input %v4
      %pout = OpTypePointer Output %v4
       %in0 = OpVariable %pin Input
       %in1 = OpVariable %pin Input
       %in2 = OpVariable %pin Input
       %in3 = OpVariable %pin Input
       %in4 = OpVariable %pin Input
       %in5 = OpVariable %pin Input
