         %s14 = OpFAdd %v4 %s13 %l14
         %s15 = OpFAdd %v4 %s14 %l15
         %s16 = OpFAdd %v4 %s15 %l16
         %s17 = OpFAdd %v4 %s16 %l17
         %s18 = OpFAdd %v4 %s17 %l18
         %s19 = OpFAdd %v4 %s18 %l19
         %s20 = OpFAdd %v4 %s19 %l20
         %s21 = OpFAdd %v4 %s20 %l21
         %s22 = OpFAdd %v4 %s21 %l22
         %s23 = OpFAdd %v4 %s22 %l23
         %s24 = OpFAdd %v4 %s23 %l24
         %s25 = OpFAdd %v4 %s24 %l25
         %s26 = OpFAdd %v4 %s25 %l26
         %s27 = OpFAdd %v4 %s26 %l27
         %s28 = OpFAdd %v4 %s27 %l28
         %s29 = OpFAdd %v4 %s28 %l29
