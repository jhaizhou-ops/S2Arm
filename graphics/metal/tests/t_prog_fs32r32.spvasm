         %l28 = OpLoad %v4 %in28
         %l29 = OpLoad %v4 %in29
         %l30 = OpLoad %v4 %in30
         %l31 = OpLoad %v4 %in31
         %s1 = OpFAdd %v4 %l0 %l1
         %s2 = OpFAdd %v4 %s1 %l2
         %s3 = OpFAdd %v4 %s2 %l3
         %s4 = OpFAdd %v4 %s3 %l4
         %s5 = OpFAdd %v4 %s4 %l5
         %s6 = OpFAdd %v4 %s5 %l6
         %s7 = OpFAdd %v4 %s6 %l7
