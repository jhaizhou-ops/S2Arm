<!-- 宏离线编译表生成器（见 MacroGen.cs）。引用仓内 compat/tree 的 Ryujinx.Graphics.Gpu（S2AMacroAot.Hash / Analyze 与运行时同口径）；构建加 artifacts-path -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RyuTree Condition="'$(RyuTree)' == ''">$(MSBuildThisFileDirectory)../../../compat/tree</RyuTree>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RyuTree)/src/Ryujinx.Graphics.Gpu/Ryujinx.Graphics.Gpu.csproj" />
  </ItemGroup>
</Project>
