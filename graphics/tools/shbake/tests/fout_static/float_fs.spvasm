; 反证：同一支、所有输出都写浮点值（把整数结果的 bitcast 换成浮点加法）。期望掩码 0
               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint Fragment %main "main" %o0 %o1 %o2 %fd
               OpExecutionMode %main OriginUpperLeft
               OpExecutionMode %main DepthReplacing
               OpDecorate %o0 Location 0
               OpDecorate %o1 Location 1
               OpDecorate %o2 Location 2
               OpDecorate %fd BuiltIn FragDepth
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
      %float = OpTypeFloat 32
        %int = OpTypeInt 32 1
     %v4float = OpTypeVector %float 4
   %p_v4float = OpTypePointer Output %v4float
   %p_float = OpTypePointer Output %float
         %o0 = OpVariable %p_v4float Output
         %o1 = OpVariable %p_v4float Output
         %o2 = OpVariable %p_v4float Output
         %fd = OpVariable %p_float Output
       %i0 = OpConstant %int 0
       %i3 = OpConstant %int 3
      %f1 = OpConstant %float 1
      %f2 = OpConstant %float 2
       %main = OpFunction %void None %fn
          %l = OpLabel
       %sum = OpIAdd %int %i3 %i3
      %bits = OpFAdd %float %f1 %f1
       %ch0 = OpAccessChain %p_float %o0 %i0
               OpStore %ch0 %bits
      %fsum = OpFAdd %float %f1 %f2
       %ch1 = OpAccessChain %p_float %o1 %i0
               OpStore %ch1 %fsum
        %vec = OpCompositeConstruct %v4float %bits %f1 %f1 %f2
               OpStore %o2 %vec
               OpStore %fd %bits
               OpReturn
               OpFunctionEnd
