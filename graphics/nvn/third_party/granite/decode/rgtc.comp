#extension GL_EXT_samplerless_texture_functions : require
// S2ARM LOCAL: glslangValidator 也要求显式声明 include 扩展；glslc 下无差。
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

#include "rgtc.h"

layout(set = 0, binding = 0) writeonly uniform image2D uOutput;
layout(set = 0, binding = 1) uniform utexture2D uInput;

layout(push_constant) uniform Registers
{
    ivec2 resolution;
} registers;

layout(constant_id = 0) const bool DUAL_COMPONENT = false;
// S2ARM LOCAL: BC4/BC5 的 SNORM 变体。端点是有符号 int8（-128 保留→-127），
// e0 <= e1 时 index 6/7 输出 -1/+1（无符号版是 0/1）；其余结构与上游 UNORM 解码一致。
layout(constant_id = 1) const bool SIGNED = false;

float decode_alpha_rgtc_signed(uvec2 payload, int linear_pixel)
{
    int e0 = max((int(payload.x) << 24) >> 24, -127);
    int e1 = max((int(payload.x >> 8) << 24) >> 24, -127);
    float ep0 = float(e0) / 127.0;
    float ep1 = float(e1) / 127.0;
    bool range7 = e0 > e1;

    int bit_offset = 16 + linear_pixel * 3;
    uint bits;
    if (bit_offset <= 29)
        bits = bitfieldExtract(payload.x, bit_offset, 3);
    else if (bit_offset >= 32)
        bits = bitfieldExtract(payload.y, bit_offset - 32, 3);
    else
        bits = bitfieldExtract(payload.x, 31, 1) | ((payload.y & 3) << 1);

    if (bits < 2)
        return bits != 0 ? ep1 : ep0;
    if (range7)
        return mix(ep0, ep1, (1.0 / 7.0) * float(bits - 1));
    if (bits > 5)
        return float(int(bits & 1) * 2 - 1);
    return mix(ep0, ep1, (1.0 / 5.0) * float(bits - 1));
}

ivec2 build_coord()
{
    ivec2 base = ivec2(gl_WorkGroupID.xy) * 8;
    base.x += 4 * (int(gl_LocalInvocationID.z) & 1);
    base.y += 2 * (int(gl_LocalInvocationID.z) & 2);
    base += ivec2(gl_LocalInvocationID.xy);
    return base;
}

void main()
{
    ivec2 coord = build_coord();
    if (any(greaterThanEqual(coord, registers.resolution)))
        return;

    ivec2 tile_coord = coord >> 2;
    ivec2 pixel_coord = coord & 3;
    int linear_pixel = 4 * pixel_coord.y + pixel_coord.x;
    uvec4 payload = texelFetch(uInput, tile_coord, 0);

    vec4 rg = vec4(0);
    if (SIGNED)
    {
        rg.x = decode_alpha_rgtc_signed(payload.xy, linear_pixel);
        if (DUAL_COMPONENT)
            rg.y = decode_alpha_rgtc_signed(payload.zw, linear_pixel);
    }
    else
    {
        rg.x = decode_alpha_rgtc(payload.xy, linear_pixel);
        if (DUAL_COMPONENT)
            rg.y = decode_alpha_rgtc(payload.zw, linear_pixel);
    }

    imageStore(uOutput, coord, rg);
}