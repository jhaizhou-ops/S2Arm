{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s2arm.local/contracts/game-input-manifest.v1.schema.json",
  "title": "S2Arm game input manifest v1",
  "description": "Frozen input selection produced by A4 inspect/resolve. It is the only input to A4 build/pack; it is not the installed-game activation pointer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "titleId",
    "name",
    "displayVersion",
    "base",
    "modules",
    "romfs",
    "tool"
  ],
  "properties": {
    "extensions": {
      "description": "Optional namespaced metadata. Unknown entries may be ignored; required behavior must be declared in requiredFeatures.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "requiredFeatures": {
      "description": "Namespaced capabilities that every consumer must support; unknown features must be rejected.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
      }
    },
    "version": {
      "const": 1
    },
    "titleId": {
      "type": "string",
      "pattern": "^[0-9A-F]{16}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "displayVersion": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentId",
        "version",
        "sha256"
      ],
      "properties": {
        "contentId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "update": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contentId",
            "version",
            "sha256"
          ],
          "properties": {
            "contentId": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "dlc": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "sha256",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "systemData": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "version",
            "sha256"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "buildId",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "exefs",
              "nro"
            ]
          },
          "buildId": {
            "type": "string",
            "pattern": "^([0-9a-f]{32}|[0-9a-f]{40})$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "romfs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentRoot",
        "files",
        "bytes"
      ],
      "properties": {
        "contentRoot": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "files": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
