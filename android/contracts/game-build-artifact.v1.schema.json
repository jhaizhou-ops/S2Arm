{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s2arm.local/contracts/game-build-artifact.v1.schema.json",
  "title": "S2Arm Android game build artifact v1",
  "description": "One verified revision. Lives at <revisionDir>/game-build-artifact.json. All paths are relative to the revision root.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "titleId",
    "contentRoot",
    "target",
    "guestAbi",
    "rewriteAbi",
    "runtime",
    "package",
    "npdm",
    "control",
    "romfs",
    "modules"
  ],
  "properties": {
    "extensions": {
      "description": "Optional namespaced metadata. Unknown entries may be ignored; required behavior must be declared in requiredFeatures.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "requiredFeatures": {
      "description": "Namespaced capabilities that every consumer must support; unknown features must be rejected.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
      }
    },
    "version": {
      "const": 1
    },
    "titleId": {
      "type": "string",
      "pattern": "^[0-9A-F]{16}$"
    },
    "contentRoot": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "target": {
      "const": "android"
    },
    "guestAbi": {
      "const": "aarch64"
    },
    "rewriteAbi": {
      "type": "string",
      "enum": [
        "android-sp-safe-v1"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "backend"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "backend": {
          "type": "string",
          "enum": [
            "vulkan"
          ]
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "indexSha256",
        "files",
        "bytes"
      ],
      "properties": {
        "manifest": {
          "type": "string",
          "const": "manifest.json"
        },
        "indexSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "npdm": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
    },
    "control": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
    },
    "romfs": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
    },
    "systemData": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
    },
    "aoc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "root"
      ],
      "properties": {
        "index": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
        },
        "root": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
        }
      }
    },
    "shaders": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "image",
          "fixups",
          "gates",
          "target"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_]+$"
          },
          "image": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.patched.bin$"
          },
          "fixups": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.fixups.tsv$"
          },
          "gates": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.gates.tsv$"
          },
          "widen": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.widen.tsv$"
          },
          "buildId": {
            "type": "string",
            "pattern": "^([0-9a-f]{32}|[0-9a-f]{40})$"
          },
          "target": {
            "const": "android"
          },
          "source": {
            "type": "string",
            "enum": [
              "apk-asset",
              "revision"
            ]
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rewriter": {
          "type": "string",
          "minLength": 1
        },
        "packer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "apk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageName",
        "versionCode",
        "sha256",
        "signingCertSha256",
        "assetRoot"
      ],
      "properties": {
        "packageName": {
          "type": "string",
          "pattern": "^org\\.s2arm\\.game\\.t[0-9a-f]{16}(\\.w2)?(?![\\s\\S])",
          "description": "Per-game applicationId: org.s2arm.game.t + lowercase titleId, optionally suffixed with exactly .w2 for a Debug test install. Structural validity does not authorize execution; the installed app identity and DebugGate must be checked."
        },
        "versionCode": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "APK SHA-256. Used by the A4 deployment transaction and export audit, not hashed on every launch."
        },
        "signingCertSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the signing certificate; the shell compares it with PackageManager GET_SIGNING_CERTIFICATES."
        },
        "assetRoot": {
          "const": "game/modules",
          "description": "Asset directory inside the APK; #24 writes game/modules."
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest",
        "manifestSha256",
        "contentRoot",
        "titleId"
      ],
      "properties": {
        "manifest": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.json$"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "contentRoot": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "titleId": {
          "type": "string",
          "pattern": "^[0-9A-F]{16}$"
        }
      }
    }
  }
}
