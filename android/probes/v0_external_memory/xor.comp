#version 450
// d[i] = s[i] ^ key: the GPU must really read s and write d; a stale or skipped copy cannot pass.
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer Src { uint s[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Dst { uint d[]; };
layout(push_constant) uniform Push { uint n; uint key; } pc;

void main() {
    uint stride = gl_NumWorkGroups.x * 256u;
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += stride) d[i] = s[i] ^ pc.key;
}
