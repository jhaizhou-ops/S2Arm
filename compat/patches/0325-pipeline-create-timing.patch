+        // S2A：Android 启动期 GPU 线程连续满载，区分是驱动管线编译还是别的工作。
+        private static void S2AReportPipelineTime(long start)
+        {
+            double ms = (System.Diagnostics.Stopwatch.GetTimestamp() - start) * 1000.0 / System.Diagnostics.Stopwatch.Frequency;
+            _s2aPipeCount++;
+            _s2aPipeMs += (long)ms;
+            if ((long)ms > _s2aPipeMax) _s2aPipeMax = (long)ms;
+            if (ms > 50) _s2aPipeSlow++;
+            long now = Environment.TickCount64;
+            if (now - _s2aPipeReported >= 5000)
+            {
+                _s2aPipeReported = now;
+                Console.Error.WriteLine($"[vkpb] 管线创建：{_s2aPipeCount} 条、总 {_s2aPipeMs} ms、max {_s2aPipeMax} ms、>50ms {_s2aPipeSlow}");
+                _s2aPipeCount = _s2aPipeMs = _s2aPipeMax = _s2aPipeSlow = 0;
+            }
+        }
 
         public PipelineUid Internal;
 
