+                    has = true;
+                }
+
+                if (has)
+                {
+                    for (int j = 0; j < other.Count; j++)
+                    {
+                        if (piece.OverlapsWith(other.GetSubRangeUnchecked(j)))
+                        {
+                            return true;
+                        }
+                    }
+                }
+
+                if ((long)size <= 0)
+                {
+                    break;
+                }
+
+                offset -= range.Size;
+            }
+
+            return false;
+        }
