+        private void S2AAlphaTestRuntime()
+        {
+            Operand op = this.Load(StorageKind.ConstantBuffer, SupportBuffer.Binding, Const((int)SupportBufferField.FragmentAlphaTest), Const(0));
+            Operand pass;
+            if ((TranslatorContext.Definitions.OmapTargets & 8) != 0)
+            {
+                Operand alpha = Register(3, RegisterType.Gpr);
+                Operand alphaRef = this.Load(StorageKind.ConstantBuffer, SupportBuffer.Binding, Const((int)SupportBufferField.FragmentAlphaTest), Const(1));   // float 位（IR 操作数不分类型）
+                Operand Is(AlphaTestOp o) => this.ICompareEqual(op, Const((int)o));
+                Operand Cmp(Instruction c) => Add(Instruction.FP32 | c, Local(), alpha, alphaRef);
+                pass = Is(AlphaTestOp.Always);
+                pass = this.BitwiseOr(pass, this.BitwiseAnd(Is(AlphaTestOp.Equal), Cmp(Instruction.CompareEqual)));
+                pass = this.BitwiseOr(pass, this.BitwiseAnd(Is(AlphaTestOp.Greater), Cmp(Instruction.CompareGreater)));
+                pass = this.BitwiseOr(pass, this.BitwiseAnd(Is(AlphaTestOp.GreaterOrEqual), Cmp(Instruction.CompareGreaterOrEqual)));
+                pass = this.BitwiseOr(pass, this.BitwiseAnd(Is(AlphaTestOp.Less), Cmp(Instruction.CompareLess)));
+                pass = this.BitwiseOr(pass, this.BitwiseAnd(Is(AlphaTestOp.LessOrEqual), Cmp(Instruction.CompareLessOrEqual)));
+                pass = this.BitwiseOr(pass, this.BitwiseAnd(Is(AlphaTestOp.NotEqual), Cmp(Instruction.CompareNotEqual)));
+            }
+            else
+            {
+                pass = this.ICompareNotEqual(op, Const((int)AlphaTestOp.Never));   // 不写 alpha：原版只在 Never 时丢弃
+            }
+            Operand passLabel = Label();
+            this.BranchIfTrue(passLabel, pass);
+            this.Discard();
+            this.MarkLabel(passLabel);
+        }
