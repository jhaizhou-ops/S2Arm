diff --git a/src/Ryujinx.HLE/HOS/Applets/Browser/BrowserApplet.cs b/src/Ryujinx.HLE/HOS/Applets/Browser/BrowserApplet.cs
index c8bbfc4b4675ce18b3391e00a32f145a8f5db85d..af368fd88075ce9b9626a009e4994a360d0bd3c7 100644
--- a/src/Ryujinx.HLE/HOS/Applets/Browser/BrowserApplet.cs
+++ b/src/Ryujinx.HLE/HOS/Applets/Browser/BrowserApplet.cs
@@ -54,6 +54,18 @@ namespace Ryujinx.HLE.HOS.Applets.Browser
                     ExitReason = WebExitReason.ExitButton,
                 };
 
+                // S2Arm (11-04 BioShock Remastered 首次启动卡死): the host renders no web page, so an offline page answers the way a headless
+                //   browser does in the yuzu lineage (DefaultWebBrowserApplet::OpenLocalWebPage → WindowClosed, last_url "http://localhost/"):
+                //   the page ran to its own end and closed. BioShock loops `ShowOfflineHtmlPage(terms of service)` until GetOfflineExitReason() == 4,
+                //   so ExitButton (0, the player backing out without accepting) made it reopen the page ~26k times a second and never draw a frame.
+                if (_shimKind == ShimKind.Offline)
+                {
+                    result.ExitReason = WebExitReason.WindowClosed;
+                    ReadOnlySpan<byte> lastUrl = "http://localhost/"u8;
+                    lastUrl.CopyTo(result.LastUrl.AsSpan());
+                    result.LastUrlSize = (ulong)lastUrl.Length;
+                }
+
                 _normalSession.Push(BuildResponseOld(result));
             }
 
