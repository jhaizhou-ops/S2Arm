diff --git a/src/Ryujinx.Graphics.Gpu/Image/S2AStaleCheck.cs b/src/Ryujinx.Graphics.Gpu/Image/S2AStaleCheck.cs
new file mode 100644
index 0000000000000000000000000000000000000000..c1066e5d95d8493ab24e4a1db9953e47e27a5da7
--- /dev/null
+++ b/src/Ryujinx.Graphics.Gpu/Image/S2AStaleCheck.cs
@@ -0,0 +1,140 @@
+using Ryujinx.Common;
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+
+namespace Ryujinx.Graphics.Gpu.Image
+{
+    // S2A 诊断（帧率能耗线 10-23，八方2 地面黑块）：贴图「漏写」检测，S2A_STALE_CHECK=<秒>（缺省关，关时零开销）。
+    // 要证明的事：宿主贴图内容是不是某次 CPU 写没变成跟踪事件、一直停在旧数据（黑块局绘制数与正常局相同，坏在数据不在少画）。
+    // 做法：整张同步时记下所用客体内存的哈希；每隔 N 秒、在 GPU 线程刚排空写跟踪之后（游戏此前的写都已成事件），
+    // 对「上次整张同步过、组里没有 GPU 改过、也没有脏句柄」的贴图重算客体内存哈希。不同 = 内容变了却没被标脏（嫌疑）。
+    // 排空之后、检查之前别的线程刚写的会误中，所以嫌疑留到下一次排空再确认：那时仍没脏、仍不同才报「漏写」。
+    static class S2AStaleCheck
+    {
+        public static readonly bool On;
+        private static readonly long _interval;
+        private static long _next;
+        private static int _pass;
+        private static readonly List<(Texture Tex, Hash128 Now)> _suspects = [];
+        private static readonly List<Texture> _all = [];
+        private static readonly HashSet<Texture> _reported = [];
+        // 正对照：S2A_STALE_SELFTEST=1 时第一遍对一张可查贴图做一次不经跟踪的 1 字节写（不产生脏事件），检测必须确认它
+        private static bool _selfTest = Environment.GetEnvironmentVariable("S2A_STALE_SELFTEST") == "1";
+        private static Texture _selfTestTex;
+
+        static S2AStaleCheck()
+        {
+            if (int.TryParse(Environment.GetEnvironmentVariable("S2A_STALE_CHECK"), out int s) && s > 0)
+            {
+                On = true;
+                _interval = s * Stopwatch.Frequency;
+                Ryujinx.Memory.S2AWriteLog.On = true;
+            }
+        }
+
+        /// <summary>GPU 线程、写跟踪刚排空之后调</summary>
+        public static void AfterDrain(GpuContext context)
+        {
+            if (_suspects.Count != 0)
+            {
+                Confirm();
+            }
+
+            long now = Stopwatch.GetTimestamp();
+
+            if (now < _next)
+            {
+                return;
+            }
+
+            _next = now + _interval;
+            Scan(context);
+        }
+
+        private static void Scan(GpuContext context)
+        {
+            _pass++;
+            _all.Clear();
+
+            foreach (Memory.PhysicalMemory pm in context.PhysicalMemoryRegistry.Values)
+            {
+                pm.TextureCache.S2AForEach(_all);
+            }
+
+            int eligible = 0;
+            long t0 = Stopwatch.GetTimestamp();
+
+            foreach (Texture t in _all)
+            {
+                if (!t.S2AEligible())
+                {
+                    continue;
+                }
+
+                eligible++;
+
+                if (_selfTest)
+                {
+                    _selfTest = false;
+                    _selfTestTex = t;
+                    t.S2ASelfTestCorrupt();
+                    Console.Error.WriteLine($"[漏写检测·正对照] 已对 {t.S2ADescribe()} 做 1 字节不跟踪写，下一遍必须确认它");
+                }
+
+                Hash128 h = t.S2AGuestHash();
+
+                if (h != t.S2ASyncHash)
+                {
+                    _suspects.Add((t, h));
+                }
+            }
+
+            double ms = (Stopwatch.GetTimestamp() - t0) * 1000.0 / Stopwatch.Frequency;
+            Console.Error.WriteLine($"[漏写检测] 第 {_pass} 遍：贴图 {_all.Count}，可查 {eligible}，嫌疑 {_suspects.Count}，耗时 {ms:F1} ms");
+            _all.Clear();
+        }
+
+        private static void Confirm()
+        {
+            int confirmed = 0;
+
+            foreach ((Texture t, Hash128 seen) in _suspects)
+            {
+                // 已被标脏（排空前的写）/ 已重新同步 / 已被 GPU 改：不是漏写
+                if (!t.S2AEligible())
+                {
+                    continue;
+                }
+
+                Hash128 h = t.S2AGuestHash();
+
+                if (h == t.S2ASyncHash)
+                {
+                    continue;
+                }
+
+                confirmed++;
+
+                if (t == _selfTestTex)
+                {
+                    Console.Error.WriteLine("[漏写检测·正对照] 通过：不跟踪写被确认");
+                }
+
+                if (_reported.Add(t))
+                {
+                    Console.Error.WriteLine($"[漏写检测·确认] 第 {_pass} 遍：{t.S2ADescribe()}；同步后客体内存变了却没被标脏（上次整张同步在第 {t.S2ASyncPass} 遍之前）{t.S2AWriters()}");
+                }
+            }
+
+            if (confirmed != 0)
+            {
+                Console.Error.WriteLine($"[漏写检测] 第 {_pass} 遍确认 {confirmed} 张（嫌疑 {_suspects.Count}）");
+            }
+
+            _suspects.Clear();
+        }
+
+        public static int Pass => _pass;
+    }
+}
