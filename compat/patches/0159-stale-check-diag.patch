diff --git a/src/Ryujinx.Memory/S2AWriteLog.cs b/src/Ryujinx.Memory/S2AWriteLog.cs
new file mode 100644
index 0000000000000000000000000000000000000000..bf5ab66f0bdd81b6cce94a3a909396c34392188b
--- /dev/null
+++ b/src/Ryujinx.Memory/S2AWriteLog.cs
@@ -0,0 +1,63 @@
+using System;
+using System.Diagnostics;
+using System.Text;
+
+namespace Ryujinx.Memory
+{
+    // S2A 诊断（帧率能耗线 10-23，地面黑块漏写检测）：最近 4096 次不跟踪写（地址、长度、是否回写、调用方两层方法名）环形记录。
+    // 只在漏写检测开着时由 Ryujinx.Graphics.Gpu.Image.S2AStaleCheck 打开；关时 Note 只多一次布尔判断。
+    public static class S2AWriteLog
+    {
+        public static bool On;
+        private const int N = 4096;
+        private static readonly (ulong Va, int Len, bool Flush, long Tick, string Who)[] _ring = new (ulong, int, bool, long, string)[N];
+        private static long _n;
+        private static readonly object _lock = new();
+
+        public static void Note(ulong va, int len, bool flush)
+        {
+            if (!On)
+            {
+                return;
+            }
+
+            StackTrace st = new(2, false);
+            StringBuilder sb = new();
+
+            for (int i = 0; i < 3 && i < st.FrameCount; i++)
+            {
+                var m = st.GetFrame(i)?.GetMethod();
+                sb.Append(i == 0 ? "" : " ← ").Append(m?.DeclaringType?.Name).Append('.').Append(m?.Name);
+            }
+
+            lock (_lock)
+            {
+                _ring[_n++ % N] = (va, len, flush, Stopwatch.GetTimestamp(), sb.ToString());
+            }
+        }
+
+        /// <summary>环里与 [va, va+size) 重叠的不跟踪写，最近的在前，最多 max 条</summary>
+        public static string Find(ulong va, ulong size, int max = 4)
+        {
+            StringBuilder sb = new();
+            int hit = 0;
+
+            lock (_lock)
+            {
+                for (long k = _n - 1; k >= 0 && k >= _n - N && hit < max; k--)
+                {
+                    var e = _ring[k % N];
+
+                    if (e.Va < va + size && va < e.Va + (ulong)e.Len)
+                    {
+                        double ago = (Stopwatch.GetTimestamp() - e.Tick) * 1000.0 / Stopwatch.Frequency;
+                        sb.Append($"｜0x{e.Va:x}+{e.Len} {(e.Flush ? "回写" : "引擎写")} {ago:F0} ms 前 {e.Who}");
+                        hit++;
+                    }
+                }
+            }
+
+            return hit == 0 ? "｜环内（最近 4096 次）无重叠的不跟踪写" : sb.ToString();
+        }
+    }
+}
