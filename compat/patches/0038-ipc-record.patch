diff --git a/src/Ryujinx.HLE/HOS/Services/S2AIpcRecord.cs b/src/Ryujinx.HLE/HOS/Services/S2AIpcRecord.cs
new file mode 100644
index 0000000000000000000000000000000000000000..a654b4056b3c6f6d2eb68a5ddd6994c04525fd73
--- /dev/null
+++ b/src/Ryujinx.HLE/HOS/Services/S2AIpcRecord.cs
@@ -0,0 +1,63 @@
+using Ryujinx.Common;
+using Ryujinx.HLE.HOS.Ipc;
+using System;
+using System.IO;
+using System.Text;
+
+namespace Ryujinx.HLE.HOS.Services
+{
+    // S2Arm differential IPC record, HLE framework side (see Ryujinx.Common.S2ARecord). Called once per handled command,
+    // after the result has been written to the response.
+    static class S2AIpcRecord
+    {
+        // The check stays in its own method: the record body captures parameters in lambdas, and the compiler allocates that
+        // closure at method entry — it must not run (allocate) on the hot path when recording is off
+        public static void Command(IpcService service, int commandId, ServiceCtx context, long result, bool tipc)
+        {
+            if (S2ARecord.Enabled)
+            {
+                Write(service, commandId, context, result, tipc);
+            }
+        }
+
+        [System.Runtime.CompilerServices.MethodImpl(System.Runtime.CompilerServices.MethodImplOptions.NoInlining)]
+        private static void Write(IpcService service, int commandId, ServiceCtx context, long result, bool tipc)
+        {
+            IpcMessage req = context.Request;
+            IpcMessage resp = context.Response;
+            StringBuilder sb = new();
+
+            sb.Append(tipc ? "HLE-TIPC" : "HLE").Append('\t');
+            sb.Append(service is DummyService dummy ? dummy.ServiceName : service.GetType().FullName).Append('\t').Append(commandId);
+
+            S2ARecord.AppendHash(sb, "in", ReadAll(context.RequestData.BaseStream));
+            S2ARecord.AppendBuffers(sb, "x", req.PtrBuff.Count, i => (req.PtrBuff[i].Position, req.PtrBuff[i].Size), Read(context));
+            S2ARecord.AppendBuffers(sb, "a", req.SendBuff.Count, i => (req.SendBuff[i].Position, req.SendBuff[i].Size), Read(context));
+            sb.Append("\th=").Append(req.HandleDesc?.ToCopy.Length ?? 0).Append('/').Append(req.HandleDesc?.ToMove.Length ?? 0);
+            sb.Append(req.HandleDesc?.HasPId == true ? "+pid" : "");
+
+            sb.Append("\trc=").Append(result.ToString("x"));
+            S2ARecord.AppendHash(sb, "out", ReadAll(context.ResponseData.BaseStream));
+            S2ARecord.AppendBuffers(sb, "b", req.ReceiveBuff.Count, i => (req.ReceiveBuff[i].Position, req.ReceiveBuff[i].Size), Read(context));
+            S2ARecord.AppendBuffers(sb, "w", req.ExchangeBuff.Count, i => (req.ExchangeBuff[i].Position, req.ExchangeBuff[i].Size), Read(context));
+            S2ARecord.AppendBuffers(sb, "c", req.RecvListBuff.Count, i => (req.RecvListBuff[i].Position, req.RecvListBuff[i].Size), Read(context));
+            sb.Append("\toh=").Append(resp.HandleDesc?.ToCopy.Length ?? 0).Append('/').Append(resp.HandleDesc?.ToMove.Length ?? 0);
+            sb.Append("\tobj=").Append(resp.ObjectIds.Count);
+
+            S2ARecord.Line(sb);
+        }
+
+        private static Action<ulong, Span<byte>> Read(ServiceCtx context) => (address, dest) => context.Memory.Read(address, dest);
+
+        private static byte[] ReadAll(Stream s)
+        {
+            long pos = s.Position;
+            byte[] data = new byte[s.Length];
+            s.Position = 0;
+            s.ReadExactly(data);
+            s.Position = pos;
+
+            return data;
+        }
+    }
+}
diff --git a/src/Ryujinx.Horizon/Sdk/Sf/Cmif/S2AIpcRecord.cs b/src/Ryujinx.Horizon/Sdk/Sf/Cmif/S2AIpcRecord.cs
new file mode 100644
index 0000000000000000000000000000000000000000..3baf7d089039d00adc26f63579ebb747be701d14
--- /dev/null
+++ b/src/Ryujinx.Horizon/Sdk/Sf/Cmif/S2AIpcRecord.cs
@@ -0,0 +1,57 @@
+using Ryujinx.Common;
+using Ryujinx.Horizon.Common;
+using Ryujinx.Horizon.Sdk.Sf.Hipc;
+using System;
+using System.Runtime.InteropServices;
+using System.Text;
+
+namespace Ryujinx.Horizon.Sdk.Sf.Cmif
+{
+    // S2Arm differential IPC record, Horizon framework side (see Ryujinx.Common.S2ARecord). Called once per handled command,
+    // after the CMIF out header has been written.
+    static class S2AIpcRecord
+    {
+        // The check stays in its own method (the body's lambdas allocate a closure at method entry)
+        public static void Command(scoped ref ServiceDispatchContext context, string objectName, uint commandId, ReadOnlySpan<byte> inRawData, Result result)
+        {
+            if (S2ARecord.Enabled)
+            {
+                Write(ref context, objectName, commandId, inRawData, result);
+            }
+        }
+
+        [System.Runtime.CompilerServices.MethodImpl(System.Runtime.CompilerServices.MethodImplOptions.NoInlining)]
+        private static void Write(scoped ref ServiceDispatchContext context, string objectName, uint commandId, ReadOnlySpan<byte> inRawData, Result result)
+        {
+            HipcMessageData req = context.Request.Data;
+            StringBuilder sb = new();
+
+            sb.Append("HZN\t").Append(objectName).Append('\t').Append(commandId);
+
+            S2ARecord.AppendHash(sb, "in", inRawData);
+
+            HipcStaticDescriptor[] statics = req.SendStatics.ToArray();
+            HipcBufferDescriptor[] send = req.SendBuffers.ToArray();
+            HipcBufferDescriptor[] recv = req.ReceiveBuffers.ToArray();
+            HipcBufferDescriptor[] exch = req.ExchangeBuffers.ToArray();
+
+            S2ARecord.AppendBuffers(sb, "x", statics.Length, i => (statics[i].Address, statics[i].Size), Read);
+            S2ARecord.AppendBuffers(sb, "a", send.Length, i => (send[i].Address, send[i].Size), Read);
+            sb.Append("\th=").Append(req.CopyHandles.Length).Append('/').Append(req.MoveHandles.Length);
+            sb.Append(context.Request.Meta.SendPid ? "+pid" : "");
+
+            sb.Append("\trc=").Append(((long)result.ErrorCode).ToString("x"));
+
+            HipcMessage resp = new(context.OutMessageBuffer);
+            S2ARecord.AppendHash(sb, "out", MemoryMarshal.AsBytes(resp.Data.DataWords));
+            S2ARecord.AppendBuffers(sb, "b", recv.Length, i => (recv[i].Address, recv[i].Size), Read);
+            S2ARecord.AppendBuffers(sb, "w", exch.Length, i => (exch[i].Address, exch[i].Size), Read);
+            sb.Append("\tc=").Append(req.ReceiveList.Length);
+            sb.Append("\toh=").Append(resp.Data.CopyHandles.Length).Append('/').Append(resp.Data.MoveHandles.Length);
+
+            S2ARecord.Line(sb);
+        }
+
+        private static void Read(ulong address, Span<byte> dest) => HorizonStatic.AddressSpace.Read(address, dest);
+    }
+}
