+        /// <summary>
+        /// Converts a managed SocketError value, whose numeric domain is Winsock on every OS.
+        /// </summary>
+        /// <remarks>
+        /// ConvertError receives native SocketException.ErrorCode on Apple platforms instead.
+        /// Passing WouldBlock (10035) through that native errno table leaks the host value to the guest.
+        /// Keep the two domains separate; unmapped values retain the existing fallback behavior.
+        /// </remarks>
+        public static LinuxError ConvertSocketError(SocketError socketError)
+        {
+            if (_errorMap.TryGetValue((WsaError)socketError, out LinuxError errno))
+            {
+                return errno;
+            }
+
+            return (LinuxError)socketError;
+        }
+
