+        /// <summary>
+        /// S2Arm (10-23 声音停了自愈): the device was stopped and will never hand the in-flight buffers back (system stopped the
+        /// queue, then we stopped it synchronously): put every in-flight buffer back into the pool.
+        /// </summary>
+        /// <returns>The bytes those buffers held (dropped, never played)</returns>
+        public int ReclaimAll()
+        {
+            lock (_lock)
+            {
+                int total = 0;
+
+                for (int slot = 0; slot < _filled.Length; slot++)
+                {
+                    int bytes = _filled[slot];
+
+                    if (bytes == 0)
+                    {
+                        continue;
+                    }
+
+                    _filled[slot] = 0;
+                    _free[_freeCount++] = slot;
+                    total += bytes;
+                }
+
+                Interlocked.Add(ref _inFlightBytes, -total);
+
+                return total;
+            }
+        }
+
         /// <summary>
