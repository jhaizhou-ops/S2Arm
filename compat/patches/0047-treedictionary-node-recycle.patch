+        // S2Arm: removed nodes are kept on a free list and reused by later inserts, so a steady add/remove pattern (nvhost-as
+        // address space map/unmap every frame) does not allocate. Nodes are never exposed outside the dictionary.
+        private Node<TKey, TValue> _free;
+
+        private Node<TKey, TValue> NewNode(TKey key, TValue value, Node<TKey, TValue> parent)
+        {
+            Node<TKey, TValue> node = _free;
+
+            if (node == null)
+            {
+                return new Node<TKey, TValue>(key, value, parent);
+            }
+
+            _free = node.Right;
+            node.Key = key;
+            node.Value = value;
+            node.Parent = parent;
+            node.Right = null;
+            node.Color = true;
+
+            return node;
+        }
+
+        private void Recycle(Node<TKey, TValue> node)
+        {
+            node.Key = default;
+            node.Value = default;
+            node.Parent = null;
+            node.Left = null;
+            node.Predecessor = null;
+            node.Successor = null;
+            node.Right = _free;
+            _free = node;
+        }
