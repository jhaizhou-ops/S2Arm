+        [CmifCommand(3)] // 20.0.0+
+        // S2Arm: DevNotify(nn::diag::DevNotificationHeader (0x28 in-data, opaque), buffer<char, 0x21> text). Wire format from the Zelda OoT (Switch 2)
+        //   sdk proxy; nn::lm::DevNotify aborts on any failing result except one code, and the game imports nn::diag::detail::DevNotifyImpl.
+        //   lm's job is to take the notification; no developer host is attached to this console, so it only goes to the guest log.
+        public Result DevNotify(DevNotificationHeader header, [Buffer(HipcBufferFlags.In | HipcBufferFlags.AutoSelect)] ReadOnlySpan<byte> text)
+        {
+            int length = text.IndexOf((byte)0);
+
+            Logger.Guest?.Print(LogClass.ServiceLm, $"DevNotify (pid {_pid}): {Encoding.UTF8.GetString(length < 0 ? text : text[..length])}");
+
+            return Result.Success;
+        }
+
         private static bool SetProcessId(Span<byte> message, ulong processId)
         {
