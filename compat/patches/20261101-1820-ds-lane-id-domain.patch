diff --git a/src/Ryujinx.Graphics.Shader/CodeGen/Spirv/Instructions.cs b/src/Ryujinx.Graphics.Shader/CodeGen/Spirv/Instructions.cs
index dd8a6f1a0e2d91a91811a66a85c0a2a8704709a0..dfc8758a604ddd6298ddf9a2b29cb522ab51e6a6 100644
--- a/src/Ryujinx.Graphics.Shader/CodeGen/Spirv/Instructions.cs
+++ b/src/Ryujinx.Graphics.Shader/CodeGen/Spirv/Instructions.cs
@@ -1738,14 +1738,16 @@ namespace Ryujinx.Graphics.Shader.CodeGen.Spirv
         }
 
         // S2Arm: Metal vertex functions have SIMD-group functions but no lane-id input, and SPIRV-Cross refuses the SubgroupLocalInvocationId
-        // builtin there. In the vertex stage the lane id is computed: the lane's rank among active lanes r = simd_prefix_exclusive_sum(1), then the
+        // builtin there. In the vertex and domain stages the lane id is computed: the lane's rank among active lanes r = simd_prefix_exclusive_sum(1), then the
         // position of the r-th set bit of the hardware ballot(true) mask (5 steps of popcount bisection, straight-line). That is the hardware lane id
         // whether or not the whole SIMD group is active, so ballots and shuffles keep the hardware lane space. The rank alone was the lane id only
         // with a full group: Tears of the Kingdom's visibility counter returns early before its ballot, its "highest set bit == my lane id" lane never
         // matched and that group added nothing. Apple SIMD groups are 32 wide: the mask is the ballot's first word.
         internal static bool LaneIdEmulated(CodeGenContext context, IoVariable ioVariable)
         {
-            return ioVariable == IoVariable.SubgroupLaneId && context.Definitions.Stage == ShaderStage.Vertex;
+            // S2Arm: the domain stage too: it runs as Metal's post-tessellation vertex function, which has no lane-id input either (Bayonetta 3 DS_Vanish05 152e86c971b807e9 /
+            // de621a435f49739c failed in SPIRV-Cross with "Subgroup builtins are not available in this type of function")
+            return ioVariable == IoVariable.SubgroupLaneId && (context.Definitions.Stage == ShaderStage.Vertex || context.Definitions.Stage == ShaderStage.TessellationEvaluation);
         }
 
         private static SpvInstruction EmulatedLaneId(CodeGenContext context)
