+        /// <summary>
+        /// S2A: 常量缓冲按槽位重绑：mask 里的阶段中脏槽（allSlots 时全部槽）同原版 BindBuffers（GetBufferRange + 一次 SetUniformBuffers），其余同原版 UpdateBuffers（只同步数据）。
+        /// </summary>
+        private void S2ABindUniformBuffers(BufferCache bufferCache, uint mask, bool allSlots)
+        {
+            int rangesCount = 0;
+            Span<BufferAssignment> ranges = _ranges;
+
+            for (ShaderStage stage = ShaderStage.Vertex; stage <= ShaderStage.Fragment; stage++)
+            {
+                int si = (int)stage - 1;
+                ref BuffersPerStage buffers = ref _gpUniformBuffers[si];
+                bool rebindStage = ((mask >> si) & 1) != 0;
+                ulong slots = allSlots ? ulong.MaxValue : _s2aUbDirtySlots[si];
+                BufferStage bufferStage = BufferStageUtils.FromShaderStage(stage);
+
+                for (int index = 0; index < buffers.Count; index++)
+                {
+                    ref BufferDescriptor bindingInfo = ref buffers.Bindings[index];
+                    BufferBounds bounds = buffers.Buffers[bindingInfo.Slot];
+
+                    if (bounds.IsUnmapped)
+                    {
+                        continue;
+                    }
+
+                    if (rebindStage && ((slots >> bindingInfo.Slot) & 1) != 0)
+                    {
+                        BufferRange range = bufferCache.GetBufferRange(bounds.Range, bufferStage);
+                        ranges[rangesCount++] = new BufferAssignment(bindingInfo.Binding, range);
+                    }
+                    else
+                    {
+                        bufferCache.SynchronizeBufferRange(bounds.Range);
+                    }
+                }
+            }
+
+            if (rangesCount != 0)
+            {
+                SetHostBuffers(ranges, rangesCount, isStorage: false);
+            }
+        }
