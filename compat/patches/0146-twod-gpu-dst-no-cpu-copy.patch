+        /// <summary>S2A：物理区间上有没有被 GPU 改过、还没回写的贴图（2D 引擎 CPU 直拷前判，见 TwodClass.PixelsFromMemorySrcY0Int）。只在 GPU 线程调，重叠数组复用、零分配</summary>
+        public bool S2AHasGpuModified(MultiRange range)
+        {
+            lock (_textures)
+            {
+                int n = _textures.FindOverlaps(range, ref _s2aOverlaps);
+
+                for (int i = 0; i < n; i++)
+                {
+                    if (_s2aOverlaps[i].Group?.S2AAnyGpuModified() == true)
+                    {
+                        return true;
+                    }
+                }
+            }
+
+            return false;
+        }
+
