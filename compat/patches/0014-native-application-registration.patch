+        // S2Arm: register an application whose code runs natively outside Ryujinx (no Ryujinx CPU process to start),
+        // with the same bookkeeping LoadXxx does after a successful start
+        internal void S2ARegisterApplication(ProcessResult processResult)
+        {
+            lock (_pidLock)
+            {
+                _processesByPid[processResult.ProcessId] = processResult;
+                _latestPid = processResult.ProcessId;
+            }
+
+            TitleIDs.CurrentApplication.Value = processResult.ProgramIdText;
+        }
