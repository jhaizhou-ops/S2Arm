+        // S2Arm: option value lengths of the FreeBSD stack Horizon's bsd runs on. -1 = variable (the content decides).
+        private static int OptionLength(BsdSocketOption option, SocketOptionLevel level)
+        {
+            return (level, option) switch
+            {
+                (SocketOptionLevel.Socket, BsdSocketOption.SoLinger) => 8,                                       // struct linger
+                (SocketOptionLevel.Socket, BsdSocketOption.SoSndTimeo or BsdSocketOption.SoRcvTimeo) => 16,      // struct timeval (64-bit)
+                (SocketOptionLevel.Socket, BsdSocketOption.SoAcceptFilter) => -1,
+                (SocketOptionLevel.IP, BsdSocketOption.IpOptions) => -1,
+                (SocketOptionLevel.IP, BsdSocketOption.IpAddMembership or BsdSocketOption.IpDropMembership) => 8,   // struct ip_mreq
+                (SocketOptionLevel.IP, BsdSocketOption.IpAddSourceMembership or BsdSocketOption.IpDropSourceMembership) => 12,   // struct ip_mreq_source
+                _ => sizeof(int),
+            };
+        }
+
+        // S2Arm: getsockopt hands back optlen = min(buffer, option length) (sooptcopyout); IP_MULTICAST_TTL / LOOP answer one u_char into a one-byte buffer
+        public static int GetSocketOptionLength(BsdSocketOption option, SocketOptionLevel level, int bufferLength)
+        {
+            int length = OptionLength(option, level);
+
+            return length < 0 ? bufferLength : Math.Min(bufferLength, length);
+        }
+
+        // S2Arm: setsockopt with a value shorter than the option is EINVAL (sooptcopyin minlen); IP_MULTICAST_TTL / LOOP also take one u_char
+        public static int SetSocketOptionMinLength(BsdSocketOption option, SocketOptionLevel level)
+        {
+            if (level == SocketOptionLevel.IP && option is BsdSocketOption.IpMulticastTtl or BsdSocketOption.IpMulticastLoop)
+            {
+                return sizeof(byte);
+            }
+
+            return Math.Max(OptionLength(option, level), 0);
+        }
+
