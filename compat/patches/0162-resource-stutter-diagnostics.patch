+        private void S2ATraceSynchronization(long start, long converted, TimeSpan pauseBefore, int bytes, string path)
+        {
+            if (!S2AAllocTrace.On)
+            {
+                return;
+            }
+
+            long end = Stopwatch.GetTimestamp();
+            double convertMs = (converted - start) * 1000.0 / Stopwatch.Frequency;
+            double uploadMs = (end - converted) * 1000.0 / Stopwatch.Frequency;
+            if (convertMs >= 8 || uploadMs >= 8)
+            {
+                double pauseMs = (GC.GetTotalPauseDuration() - pauseBefore).TotalMilliseconds;
+                Console.Error.WriteLine($"[资源·贴图同步慢] tick={end} path={path} 转换 {convertMs:F3} ms、上传 {uploadMs:F3} ms、同期 GC 暂停 {pauseMs:F3} ms；{Info.FormatInfo.Format} {Info.Width}x{Info.Height}x{Info.DepthOrLayers} levels={Info.Levels} linear={Info.IsLinear} bytes={bytes}");
