                 writer.Write(capabilities.S2AStorageWindowClamp);
                 writer.Write(capabilities.S2AStorageOobRecord);
             }
+            // S2A：空集不追加——全支持的宿主身份字节与改前相同；非空时集合影响生成的
+            //   解码码流，必须把格式值写进身份，否则跨设备缓存会错配。
