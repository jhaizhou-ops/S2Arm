+                : AccessFlags.ColorAttachmentWriteBit | AccessFlags.ColorAttachmentReadBit;
+
+            public void RecordWrite(AccessFlags access, PipelineStageFlags stage)
+            {
+                WriteAccess |= access;
+                WriteStage |= stage;
