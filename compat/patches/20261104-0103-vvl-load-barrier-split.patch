+                    : PipelineStageFlags.ColorAttachmentOutputBit;
+                WriteAccess = depthStencil
+                    ? AccessFlags.DepthStencilAttachmentWriteBit
+                    : AccessFlags.ColorAttachmentWriteBit;
+            }
+        }
