+    // S2A 诊断 S2A_BUFCLASS_STAT=1（缺省关，帧率能耗线 10-23 零拷贝收益重估）：缓冲按用法分类（优先级：引擎写过 > GPU 输出 > 存储读 > 常量 > 顶点索引 > 其他），
+    // 每类累计上传字节、回写次数与耗时（含等同步号），每 10 秒一行。「引擎写过」= 常量缓冲更新 / 内联上传 / DMA 经 BufferCache.ForceDirty 标脏过
+    internal static class S2ABufClassStat
+    {
+        public static readonly bool On = System.Environment.GetEnvironmentVariable("S2A_BUFCLASS_STAT") == "1";
+        public const byte GpuOutput = 1, Uniform = 2, VertexIndex = 4, EngineWrite = 8, StorageRead = 16, Other = 32;
+        private static readonly string[] _name = { "引擎写过", "GPU 输出", "存储读", "常量", "顶点索引", "其他" };
+        private static readonly long[] _up = new long[6], _upN = new long[6], _fl = new long[6], _flT = new long[6];
+        private static long _next;
+
+        private static int Class(byte use) => (use & EngineWrite) != 0 ? 0 : (use & GpuOutput) != 0 ? 1 : (use & StorageRead) != 0 ? 2 : (use & Uniform) != 0 ? 3 : (use & VertexIndex) != 0 ? 4 : 5;
+
+        public static void NoteUpload(byte use, long bytes)
+        {
+            int k = Class(use);
+            System.Threading.Interlocked.Add(ref _up[k], bytes);
+            System.Threading.Interlocked.Increment(ref _upN[k]);
+        }
+
+        public static void NoteFlush(byte use, long ticks)
+        {
+            int k = Class(use);
+            System.Threading.Interlocked.Increment(ref _fl[k]);
+            System.Threading.Interlocked.Add(ref _flT[k], ticks);
+        }
+
+        public static void Log()
+        {
+            if (!On)
+            {
+                return;
+            }
+
+            long now = System.Diagnostics.Stopwatch.GetTimestamp();
+
+            if (now < _next)
+            {
+                return;
+            }
+
+            _next = now + System.Diagnostics.Stopwatch.Frequency * 10;
+            double f = 1000.0 / System.Diagnostics.Stopwatch.Frequency;
+            var sb = new System.Text.StringBuilder("[缓冲分类账] 累计（上传 次·MB / 回写 次·ms）：");
+
+            for (int k = 0; k < 6; k++)
+            {
+                sb.Append($" {_name[k]} {_upN[k]}·{_up[k] >> 20} / {_fl[k]}·{_flT[k] * f:F0}；");
+            }
+
+            System.Console.Error.WriteLine(sb.ToString());
+        }
+    }
+
+    // S2A 诊断 S2A_BUFFLUSH_STAT=1（缺省关，帧率能耗线 10-23 零拷贝方案 §2）：缓冲回写（ExternalFlush：游戏碰 GPU 改过的缓冲）按「读 / 写」×「GPU 线程 / 其他线程」计次数与耗时（含等同步号）。
+    // 写的那部分零拷贝后整段消失（不拷也不等），读的只剩等
+    internal static class S2ABufFlushStat
+    {
+        public static readonly bool On = System.Environment.GetEnvironmentVariable("S2A_BUFFLUSH_STAT") == "1";
+        private static readonly long[] _n = new long[4], _t = new long[4];
+        private static long _next;
+
+        public static void Note(bool read, bool gpuThread, long ticks)
+        {
+            int k = (read ? 0 : 2) + (gpuThread ? 1 : 0);
+            System.Threading.Interlocked.Increment(ref _n[k]);
+            System.Threading.Interlocked.Add(ref _t[k], ticks);
+        }
+
+        public static void Log()
+        {
+            if (!On)
+            {
+                return;
+            }
+
+            long now = System.Diagnostics.Stopwatch.GetTimestamp();
+
+            if (now < _next)
+            {
+                return;
+            }
+
+            _next = now + System.Diagnostics.Stopwatch.Frequency * 10;
+            double f = 1000.0 / System.Diagnostics.Stopwatch.Frequency;
+            System.Console.Error.WriteLine($"[缓冲回写拆账] 累计 读·其他线程 {_n[0]} 次 {_t[0] * f:F0} ms / 读·GPU 线程 {_n[1]} 次 {_t[1] * f:F0} ms / 写·其他线程 {_n[2]} 次 {_t[2] * f:F0} ms / 写·GPU 线程 {_n[3]} 次 {_t[3] * f:F0} ms");
+        }
+    }
+
 }
