@@ -196,6 +204,15 @@ namespace Ryujinx.Horizon.Sdk.Sf.Hipc
 
         protected override void RegisterSessionToWaitList(ServerSession session)
         {
+            // S2Arm: in-thread direct dispatch serves this session on the game thread; it never waits in this manager's loop
+            // (checked first: setting UserData boxes the tag, an allocation per request)
+            if (S2AHorizonHooks.SessionRegistered != null)
