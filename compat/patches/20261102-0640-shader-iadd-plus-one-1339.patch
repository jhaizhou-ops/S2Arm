+        // S2A（#1339）：AvgMode.PlusOne（.PO，取负两位同时置位）= A + B + 1，两个源都不取负（nvdisasm 显示 IADD.PO R, R, R 不带取负；Mesa NAK sm50.rs：两源都带取负时硬件编成 iadd.po）。
+        //   原实现没有这一支，.PO 被静默忽略、少加 1（#1339 lavapipe 读回）。+1 并进 B：B + 1 回绕（B = 0xffffffff）时那一位进位单独记，SetPlusOneCarry 并进 CF
+        private static Operand PlusOne(EmitterContext context, ref Operand srcB, AvgMode avgMode)
+        {
+            if (avgMode != AvgMode.PlusOne)
+            {
+                return null;
+            }
+
+            srcB = context.IAdd(srcB, Const(1));
+
+            return context.ICompareEqual(srcB, Const(0));
+        }
+
+        private static void SetPlusOneCarry(EmitterContext context, Operand poCarry, bool setCC)
+        {
+            if (setCC && poCarry != null)
+            {
+                context.Copy(GetCF(), context.BitwiseOr(GetCF(), poCarry));
+            }
+        }
