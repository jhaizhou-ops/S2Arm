+        // S2Arm: Metal vertex functions have SIMD-group functions but no lane-id input, and SPIRV-Cross refuses the SubgroupLocalInvocationId
+        // builtin there. In the vertex stage the lane id is replaced by the exclusive prefix count of active lanes (simd_prefix_exclusive_sum(1)),
+        // which equals the hardware lane id whenever the whole SIMD group is active.
+        internal static bool LaneIdEmulated(CodeGenContext context, IoVariable ioVariable)
+        {
+            return ioVariable == IoVariable.SubgroupLaneId && context.Definitions.Stage == ShaderStage.Vertex;
+        }
+
+        private static SpvInstruction EmulatedLaneId(CodeGenContext context)
+        {
+            SpvInstruction execution = context.Constant(context.TypeU32(), Scope.Subgroup);
+            return context.GroupNonUniformIAdd(context.TypeU32(), execution, GroupOperation.ExclusiveScan, context.Constant(context.TypeU32(), 1));
+        }
+
         private static OperationResult GenerateLoadOrStore(CodeGenContext context, AstOperation operation, bool isStore)
         {
+            if (!isStore && operation.StorageKind == StorageKind.Input && operation.GetSource(0) is AstOperand io0 &&
+                io0.Type == OperandType.Constant && LaneIdEmulated(context, (IoVariable)io0.Value))
+            {
+                return new OperationResult(AggregateType.U32, EmulatedLaneId(context));
+            }
+
             SpvInstruction pointer = GetStoragePointer(context, operation, out AggregateType varType);
 
             if (isStore)
