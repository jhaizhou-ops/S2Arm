             // TODO: propagate IPC late binding of "time:s" and "time:p"
         }
 
+        // S2Arm: the shared tick source stops while the game clock is frozen in background and while the host sleeps (#495: games must not see
+        // that time on the counter). A real Switch's steady clock is RTC based and keeps running through sleep, so the calendar (system clock =
+        // offset + steady clock) would otherwise lag by the whole background / sleep time. Add the increase of the unseen time to the steady
+        // clock and rebase the shared memory, which games read directly with their own counter. Idempotent; never moves the clock backwards.
+        private readonly object _s2aCatchUpLock = new();
+        private ITickSource _s2aTickSource;
+        private long _s2aUnseen;
+
+        public void S2ASteadyClockCatchUp(long unseenNs)
+        {
+            lock (_s2aCatchUpLock)
+            {
+                if (_s2aTickSource == null || unseenNs <= _s2aUnseen)
+                {
+                    return;
+                }
+
+                StandardSteadyClock.S2AAdvance(unseenNs - _s2aUnseen);
+                _s2aUnseen = unseenNs;
+                SharedMemory.SetSteadyClockRawTimePoint(_s2aTickSource, StandardSteadyClock.GetCurrentRawTimePoint(_s2aTickSource));
+            }
+        }
+
         private void SetupInternalStandardSteadyClock(UInt128 clockSourceId, TimeSpanType setupValue, TimeSpanType internalOffset, TimeSpanType testOffset, bool isRtcResetDetected)
         {
             StandardSteadyClock.SetClockSourceId(clockSourceId);
