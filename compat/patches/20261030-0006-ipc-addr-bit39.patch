diff --git a/src/Ryujinx.HLE/S2AHooks.cs b/src/Ryujinx.HLE/S2AHooks.cs
index db1efd54f1bf2e178d608e88b89be7fe3b249417..53a6164a5e081d90ecbc57635f657e9501cf36ca 100644
--- a/src/Ryujinx.HLE/S2AHooks.cs
+++ b/src/Ryujinx.HLE/S2AHooks.cs
@@ -19,6 +19,12 @@ namespace Ryujinx.HLE
         // Horizon.StartNewServices: start a Horizon (new IPC framework) service on an S2Arm thread instead of a Ryujinx kernel process
         public static delegate*<Ryujinx.Horizon.ServiceEntry, void> StartHorizonService;
 
+        // IPC buffer descriptors carry 39-bit addresses. On macOS the game's address window tops out at 2^39 and an alias region that does not
+        // fit is extended above it, so bit 39 of a buffer there is lost when the game packs the descriptor; this restores it (native
+        // svc_mem.c s2a_ipc_addr39: only when the 39-bit address is not a game address and adding bit 39 gives a mapped one). Null = as decoded.
+        public static delegate* unmanaged<ulong, ulong> IpcAddr39;
+        public static ulong FixIpcAddr(ulong a) => IpcAddr39 == null ? a : IpcAddr39(a);
+
         // Upstream silently defaulted on missing data in a few places; those now report through here (S2Arm red list)
         public static System.Action<string> Red;
 
diff --git a/src/Ryujinx.Horizon/S2AHorizonHooks.cs b/src/Ryujinx.Horizon/S2AHorizonHooks.cs
index efb329236688fbebebbff89eaa4c2335083853f6..ce99dd46a013a059472f785aa7ced4f750158482 100644
--- a/src/Ryujinx.Horizon/S2AHorizonHooks.cs
+++ b/src/Ryujinx.Horizon/S2AHorizonHooks.cs
@@ -6,8 +6,13 @@ namespace Ryujinx.Horizon
     // S2Arm: hooks for in-thread direct dispatch of Horizon services (services/S2A.Services sets them; when unset,
     // behaviour is upstream's). The game's requests are processed on the game thread through the service's own
     // ServerManager (ProcessRequest), instead of the service thread's receive loop.
-    static class S2AHorizonHooks
+    static unsafe class S2AHorizonHooks
     {
+        // IPC buffer descriptor addresses are 39-bit: restore bit 39 for a buffer in the part of the alias region above 2^39 (macOS;
+        // same native function as Ryujinx.HLE S2AHooks.IpcAddr39). Null = as decoded.
+        public static delegate* unmanaged<ulong, ulong> IpcAddr39;
+        public static ulong FixIpcAddr(ulong a) => IpcAddr39 == null ? a : IpcAddr39(a);
+
         // Android 的显式进程收局 owner；未设置时音频服务仍由上游 Shutdown 释放。
         public static Action<IDisposable> AudioCreated;
 
