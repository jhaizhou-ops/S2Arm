+        // S2Arm: the Ioctl3 form also returns the SM map in the inline buffer ({GPC, TPC} per SM, 2 bytes each). The game's NVN
+        // driver pre-fills the last entry with a 0xc0c0 sentinel and fails device creation if it is not overwritten. Upstream
+        // only fills the argument block; on desktop the kernel's pointer-buffer copy-back happens to overwrite the sentinel,
+        // which in-thread direct dispatch does not do.
+        private IoctlProcessorInlineSpan<VsmsMappingArguments, byte> _s2aVsmsMappingInline;
+
+        private NvInternalResult VsmsMappingInline(ref VsmsMappingArguments arguments, Span<byte> inlineData)
+        {
+            NvInternalResult result = VsmsMapping(ref arguments);
+
+            for (int k = 0; k + 2 <= inlineData.Length; k += 2)
+            {
+                inlineData[k] = 0;                   // GPC 0
+                inlineData[k + 1] = (byte)(k / 2);   // TPC k
+            }
+
+            return result;
+        }
