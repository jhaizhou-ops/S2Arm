diff --git a/src/Ryujinx.HLE/HOS/Services/Caps/ScreenshotEncoding.cs b/src/Ryujinx.HLE/HOS/Services/Caps/ScreenshotEncoding.cs
new file mode 100644
index 0000000000000000000000000000000000000000..6545dda1cde833b2e25356c149bbf820eac6740b
--- /dev/null
+++ b/src/Ryujinx.HLE/HOS/Services/Caps/ScreenshotEncoding.cs
@@ -0,0 +1,29 @@
+using System;
+
+namespace Ryujinx.HLE.HOS.Services.Caps
+{
+    internal sealed class ScreenshotBitmapAllocationException : Exception { }
+
+    internal static class ScreenshotEncoding
+    {
+        public static byte[] Encode(ReadOnlySpan<byte> rgba, int width, int height, int quality)
+        {
+            if (width <= 0 || height <= 0 || width > 4096 || height > 4096 ||
+                quality < 0 || quality > 100 || (long)width * height * 4 != rgba.Length)
+                throw new ArgumentException("Invalid packed RGBA screenshot");
+            byte[] jpeg;
+            if (S2AHooks.EncodeScreenshotJpeg != null)
+                jpeg = S2AHooks.EncodeScreenshotJpeg(rgba, width, height, quality);
+            else
+#if S2A_ANDROID_HOST
+                throw new NotSupportedException("Android screenshot encoder is not connected");
+#else
+                jpeg = SkiaScreenshotEncoder.Encode(rgba, width, height, quality);
+#endif
+            if (jpeg == null || jpeg.Length < 4 || jpeg[0] != 0xff || jpeg[1] != 0xd8 ||
+                jpeg[^2] != 0xff || jpeg[^1] != 0xd9)
+                throw new InvalidOperationException("Screenshot provider did not return a complete JPEG");
+            return jpeg;
+        }
+    }
+}
diff --git a/src/Ryujinx.HLE/HOS/Services/Caps/SkiaScreenshotEncoder.cs b/src/Ryujinx.HLE/HOS/Services/Caps/SkiaScreenshotEncoder.cs
new file mode 100644
index 0000000000000000000000000000000000000000..f1730dfab1120fabd5b0932dbc2b42691dbdf867
--- /dev/null
+++ b/src/Ryujinx.HLE/HOS/Services/Caps/SkiaScreenshotEncoder.cs
@@ -0,0 +1,19 @@
+using SkiaSharp;
+using System;
+
+namespace Ryujinx.HLE.HOS.Services.Caps
+{
+    // Default hosts retain the original Skia layout, JPEG quality and bytes.
+    internal static class SkiaScreenshotEncoder
+    {
+        public static unsafe byte[] Encode(ReadOnlySpan<byte> rgba, int width, int height, int quality)
+        {
+            using SKBitmap bitmap = new(new SKImageInfo(width, height, SKColorType.Rgba8888));
+            nint pixels = bitmap.GetPixels();
+            if (pixels == 0) throw new ScreenshotBitmapAllocationException();
+            rgba.CopyTo(new Span<byte>((void*)pixels, rgba.Length));
+            using SKData data = bitmap.Encode(SKEncodedImageFormat.Jpeg, quality);
+            return data?.ToArray() ?? throw new InvalidOperationException("Screenshot JPEG encoding failed");
+        }
+    }
+}
