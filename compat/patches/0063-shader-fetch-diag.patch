+            CachedShaderProgram gs;
+            try
+            {
+                gs = shaderCache.GetGraphicsShader(
+                    ref _state.State,
+                    ref _pipeline,
+                    _channel,
+                    samplerPoolMaximumId,
+                    ref _currentSpecState.GetPoolState(),
+                    ref _currentSpecState.GetGraphicsState(),
+                    addresses);
+            }
+            catch (InvalidOperationException e) when (e.Message.StartsWith("S2A: shader code fetch")) // S2A：取码安全阀报红时补现场（程序区基址 + 各阶段开关 / 偏移 / 地址）
+            {
+                var sb = new System.Text.StringBuilder($"{e.Message}；程序区基址 0x{baseAddress:X}；");
+                for (int index = 0; index < 6; index++)
+                {
+                    ShaderState sh = shaderStateSpan[index];
+                    sb.Append($"阶段 {index}：开 {sh.UnpackEnable()} 控制 0x{sh.Control:X} 类型 {sh.Type} 偏移 0x{sh.Offset:X} 地址 0x{addressesSpan[index]:X}；");
+                }
+                for (int index = 1; index < 6; index++)   // 各开着的阶段：头 0x50 字节 + 代码前 4 KB 里全零 8 字节字所占比例（判「真大」还是「那段不是代码」）
+                {
+                    ulong va = addressesSpan[index]; if (va == 0) continue;
+                    try
+                    {
+                        ReadOnlySpan<byte> hd = _channel.MemoryManager.GetSpan(va, 0x50);
+                        ReadOnlySpan<ulong> code = System.Runtime.InteropServices.MemoryMarshal.Cast<byte, ulong>(_channel.MemoryManager.GetSpan(va + 0x50, 0x1000));
+                        int zero = 0; foreach (ulong w in code) if (w == 0) zero++;
+                        sb.Append($"阶段 {index} 头 {Convert.ToHexString(hd)}；代码前 4 KB 全零字 {zero}/{code.Length}；");
+                        sb.Append(_channel.MemoryManager.Physical.TextureCache.S2ADescribeOverlaps(_channel.MemoryManager.GetPhysicalRegions(va, 0x100000))).Append('；');
+                    }
+                    catch (Exception re) { sb.Append($"阶段 {index} 读不出：{re.Message}；"); }
+                }
+                throw new InvalidOperationException(sb.ToString(), e);
+            }
 
             // Consume the modified flag for spec state so that it isn't checked again.
             _currentSpecState.SetShader(gs);
