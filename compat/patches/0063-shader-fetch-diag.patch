                 ? _state.State.TexturePoolState.MaximumId
                 : _state.State.SamplerPoolState.MaximumId;
 
-            CachedShaderProgram gs = shaderCache.GetGraphicsShader(
-                ref _state.State,
-                ref _pipeline,
-                _channel,
