+        // Processing tap counters (runtime/src/audiotap.c): device cycles, cycles the queue could not fill, frames wanted / got
+        private static readonly nint _tapAttach = TapExport("s2a_audio_tap_attach");
+        private static readonly nint _tapStats = TapExport("s2a_audio_tap_stats");
+        private bool _tapOn;
