+            ((delegate* unmanaged<int, ulong*, void>)_tapStats)(Index, t);
+            ulong calls = t[0] - _repTapCalls, shortCalls = t[1] - _repTapShort, missing = t[2] - t[3] - (_repTapWant - _repTapGot);
