+                    ShaderSpecializationState specState = ShaderSpecializationState.Read(ref dataReader);
+                    dataReader.EndCompression();
+
+                    (byte[] hostCode, CachedShaderStage[] shaders) = ReadHostCode(
+                        lazy.Context,
+                        ref _lazyHostToc,
+                        ref _lazyHostData,
+                        lazy.GuestShaders,
+                        lazy.ProgramIndex,
+                        lazy.Timestamp);
+
+                    if (hostCode == null)
+                    {
+                        S2AShaderCacheGuard.Report(1, $"程序 {lazy.ProgramIndex} 缺主机代码（按需实化）");
+                        return null;
+                    }
+
+                    ShaderInfo shaderInfo = ShaderInfoBuilder.BuildForCache(
+                        lazy.Context,
+                        shaders,
+                        specState.PipelineState,
+                        specState.TransformFeedbackDescriptors != null);
+
+                    bool hasFragmentShader = shaders.Length > 5 && shaders[5] != null;
+                    IProgram hostProgram = lazy.Context.Renderer.LoadProgramBinary(hostCode, hasFragmentShader, shaderInfo);
+
+                    if (hostProgram.CheckProgramLink(true) != ProgramLinkStatus.Success)
+                    {
+                        hostProgram.Dispose();
+                        S2AShaderCacheGuard.Report(1, $"程序 {lazy.ProgramIndex} 主机二进制载入失败（按需实化）");
+                        return null;
+                    }
+
+                    return new CachedShaderProgram(hostProgram, specState, shaders);
+                }
+                catch (Exception e) when (e is DiskCacheLoadException or IOException or InvalidDataException)
+                {
+                    S2AShaderCacheGuard.Report(1, $"程序 {lazy.ProgramIndex} 按需实化读缓存失败：{e.Message}");
+                    return null;
+                }
+            }
+        }
