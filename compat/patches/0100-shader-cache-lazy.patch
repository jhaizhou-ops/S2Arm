+                    uint stagesBitMask = lazy.IsCompute ? 1u : entry.StagesBitMask;
+                    DataEntryPerStage stageEntry = new();
+
+                    while (stagesBitMask != 0)
+                    {
+                        dataReader.Read(ref stageEntry);
+                        stagesBitMask &= stagesBitMask - 1;
+                    }
