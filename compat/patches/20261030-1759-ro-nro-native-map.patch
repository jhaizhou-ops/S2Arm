+        private static unsafe ResultCode S2AMapNro(NroInfo info, out ulong nroMappedAddress)
+        {
+            ulong mapped = 0;
+            int rc;
+
+            fixed (byte* hash = info.Hash)
+            {
+                rc = S2AHooks.NroMap(hash, info.NroSize, info.BssSize, &mapped);
+            }
+
+            nroMappedAddress = mapped;
+
+            switch (rc)
+            {
+                case 0:
+                    return ResultCode.Success;
+                case 3:
+                    return ResultCode.AlreadyLoaded;
+                case 4:
+                    S2AHooks.Red?.Invoke($"ro LoadNro: module table full ({Convert.ToHexString(info.Hash)[..8]}…)");
+                    return ResultCode.InsufficientAddressSpace;
+                default:
+                    S2AHooks.Red?.Invoke($"ro LoadNro: native map failed rc={rc} ({Convert.ToHexString(info.Hash)[..8]}…, size {info.NroSize:x}, bss {info.BssSize:x})");
+                    return ResultCode.InvalidNro;
+            }
+        }
