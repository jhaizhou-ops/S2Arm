diff --git a/src/Ryujinx.HLE/Ryujinx.HLE.csproj b/src/Ryujinx.HLE/Ryujinx.HLE.csproj
index 87690931c644413418d4cd0843cf7edecd3588aa..9a3d2ce14c4c318763419aa56c69e3e36506e57e 100644
--- a/src/Ryujinx.HLE/Ryujinx.HLE.csproj
+++ b/src/Ryujinx.HLE/Ryujinx.HLE.csproj
@@ -36,11 +36,16 @@
 
   <!-- linux-bionic is the Android host. Its platform codec is mandatory; other
        hosts retain their existing Skia implementation and package selection. -->
+  <!-- Apple hosts (macOS / iOS NativeAOT, statically linked, no libSkiaSharp.dylib) register an ImageIO
+       encoder (platform/apple/cs/capture) and never theme the inline keyboard (headless), so Skia is
+       unreachable there: removed like Android. A RID-less build on macOS (the services unit tests) is an Apple host. -->
   <PropertyGroup>
     <S2AAndroidHost Condition="'$(S2AAndroidHost)' == '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-bionic-'))">true</S2AAndroidHost>
     <DefineConstants Condition="'$(S2AAndroidHost)' == 'true'">$(DefineConstants);S2A_ANDROID_HOST</DefineConstants>
+    <S2AAppleHost Condition="'$(S2AAppleHost)' == '' and ($([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-')) or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('ios-')) or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('iossimulator-')) or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))))">true</S2AAppleHost>
+    <DefineConstants Condition="'$(S2AAppleHost)' == 'true'">$(DefineConstants);S2A_APPLE_HOST</DefineConstants>
   </PropertyGroup>
-  <ItemGroup Condition="'$(S2AAndroidHost)' == 'true'">
+  <ItemGroup Condition="'$(S2AAndroidHost)' == 'true' or '$(S2AAppleHost)' == 'true'">
     <Compile Remove="HOS/Services/Caps/SkiaScreenshotEncoder.cs" />
     <Compile Remove="HOS/Applets/SoftwareKeyboard/SoftwareKeyboardRendererBase.cs" />
     <PackageReference Remove="SkiaSharp;SkiaSharp.NativeAssets.Win32;SkiaSharp.NativeAssets.macOS;SkiaSharp.NativeAssets.Linux.NoDependencies" />
