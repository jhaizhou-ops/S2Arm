+        /// <summary>
+        /// Writes a run of consecutive standalone bindings, one write per binding.
+        /// The set layout declares each of them as its own binding with DescriptorCount 1, so writing them with a
+        /// single DescriptorCount = N goes past the end of the first binding; most drivers happen to work because
+        /// the descriptors are physically adjacent, but Adreno drops everything after the first one (samples as 0).
+        /// </summary>
+        public unsafe void UpdateImagesPerBinding(int setIndex, int baseBinding, ReadOnlySpan<DescriptorImageInfo> imageInfo, DescriptorType type)
+        {
+            fixed (DescriptorImageInfo* pImageInfo = imageInfo)
+            {
+                for (int i = 0; i < imageInfo.Length; i++)
+                {
+                    WriteDescriptorSet writeDescriptorSet = new()
+                    {
+                        SType = StructureType.WriteDescriptorSet,
+                        DstSet = _descriptorSets[setIndex],
+                        DstBinding = (uint)(baseBinding + i),
+                        DescriptorType = type,
+                        DescriptorCount = 1,
+                        PImageInfo = pImageInfo + i,
+                    };
+
+                    _holder.Api.UpdateDescriptorSets(_holder.Device, 1, in writeDescriptorSet, 0, null);
+                }
+            }
+        }
