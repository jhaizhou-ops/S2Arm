+
+    /// <summary>
+    /// Formats the GPU layer may request for vertex texel-buffer views: every
+    /// single-component attribute format plus the fixed index/topology/dummy
+    /// formats (already covered by the same values). Backends probe these for
+    /// uniform texel buffer support; unsupported entries are substituted with a
+    /// same-width integer view plus shader-side decode.
+    /// </summary>
+    public static class VertexTexelFormats
+    {
+        public static readonly Format[] All =
+        {
+            Format.R8Unorm, Format.R8Snorm, Format.R8Uint, Format.R8Sint,
+            Format.R16Float, Format.R16Unorm, Format.R16Snorm, Format.R16Uint, Format.R16Sint,
+            Format.R32Float, Format.R32Uint, Format.R32Sint,
+            Format.R10G10B10A2Unorm, Format.R10G10B10A2Uint, Format.R10G10B10A2Sint, Format.R11G11B10Float,
+        };
+
+        /// <summary>
+        /// Same-bit-width integer substitutes for attribute texel formats a host may
+        /// not support as uniform texel buffer. The integer view delivers raw bits;
+        /// the shader applies the semantic decode (AttributeType.TexelDecode).
+        /// </summary>
+        private static readonly IReadOnlyDictionary<Format, Format> ViewFallbacks = new Dictionary<Format, Format>
+        {
+            { Format.R16Float, Format.R16Uint },
+            { Format.R16Sint, Format.R16Uint },
+            { Format.R10G10B10A2Sint, Format.R32Uint },
+        };
+
+        /// <summary>
+        /// Resolves the buffer view format to use for a vertex texel fetch: when the
+        /// intended format is unsupported as uniform texel buffer, substitutes a
+        /// same-width integer fallback and marks it for shader-side decode.
+        /// </summary>
+        /// <param name="intended">The intended (guest attribute) format</param>
+        /// <param name="unsupported">Host formats without uniform texel buffer support, or null</param>
+        /// <param name="viewFormat">The format the view must be created with</param>
+        /// <param name="needsDecode">True when the view format differs in encoding and the shader must decode raw bits</param>
+        /// <returns>True when a usable view format was found, false when the format is unsupported and has no fallback</returns>
+        public static bool TryResolveViewFormat(
+            Format intended,
+            IReadOnlyCollection<Format> unsupported,
+            out Format viewFormat,
+            out bool needsDecode)
+        {
+            viewFormat = intended;
+            needsDecode = false;
+
+            if (unsupported == null || !unsupported.Contains(intended))
+            {
+                return true;
+            }
+
+            if (!ViewFallbacks.TryGetValue(intended, out viewFormat) || unsupported.Contains(viewFormat))
+            {
+                viewFormat = intended;
+                return false;
+            }
+
+            needsDecode = true;
+            return true;
+        }
+    }
 }
