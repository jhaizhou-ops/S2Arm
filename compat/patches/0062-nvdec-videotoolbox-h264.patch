         // S2Arm: shadow of a transfer memory created by the game in S2Arm's native layer; game address = host address,
-        // so services read it in place (no page borrowing, the native layer owns the game's address space)
-        internal void S2AInitializeForeign(ulong address, ulong size, KMemoryPermission permission)
+        // so services read it in place (no page borrowing, the native layer owns the game's address space).
+        // creator = the game process shadow, so code reading through Creator.CpuMemory (am storages) reaches game memory
+        internal void S2AInitializeForeign(KProcess creator, ulong address, ulong size, KMemoryPermission permission)
         {
+            _creator = creator;
             Permission = permission;
             Address = address;
             Size = size;
