+        // S2Arm: lists rented from a render system's pool (see AudioRenderSystem) keep their command list and pinned
+        // mix buffer, and go back to the pool when the processor is done, instead of being recreated every 5 ms
+        private System.Collections.Generic.Stack<CommandList> _s2aPool;
+
+        internal static CommandList S2ARent(AudioRenderSystem renderSystem, System.Collections.Generic.Stack<CommandList> pool)
+        {
+            CommandList list = null;
+
+            lock (pool)
+            {
+                if (pool.Count != 0)
+                {
+                    list = pool.Pop();
+                }
+            }
+
+            if (list == null)
+            {
+                list = new CommandList(renderSystem) { _s2aPool = pool };
+            }
+
+            list.StartTime = 0;
+            list.EndTime = 0;
+            list.OutputDevice = null;
+
+            return list;
+        }
+
         public void Dispose()
         {
+            if (_s2aPool != null)
+            {
+                Commands.Clear();
+
+                lock (_s2aPool)
+                {
+                    _s2aPool.Push(this);
+                }
+
+                return;
+            }
+
             Commands.Clear();
             CommandsListPool.Release(Commands);
             GC.SuppressFinalize(this);
