+            }
+        }
+
+        public void Close()
+        {
+            Detach();
+
+            lock (_lock)
+            {
+                _output?.Dispose();
+                _output = null;
+            }
+        }
+
+        public void Dispose()
+        {
+            Close();
+        }
+    }
